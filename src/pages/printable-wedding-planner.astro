---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Printable Wedding Planner - Free 40-Page Download" description="Get our free 40-page printable wedding planner with complete checklist, budget tracker, timeline, and vendor organizer. Download now!">
  <!-- Logo display at top -->
  <style>
    .site-logo {
      display: block;
      margin: 40px auto 20px;
      max-width: 400px;
      height: auto;
    }
  </style>
  <!-- HERO SECTION -->
  <section class="hero">
    <div class="hero-content">
      <span class="badge">📥 Free Download Available</span>
      <h1>Plan Your Dream Wedding Stress-Free</h1>
      <p>Get our comprehensive 40-page printable wedding planner</p>
      <p class="subheading">Complete checklist, budget tracker, timeline, and vendor organizer - everything you need in one place</p>
      <div class="hero-cta">
        <a href="/products/printable-wedding-planner/dist/printable-wedding-planner.pdf" class="cta-button" download>📥 Download Free PDF</a>
      </div>
    </div>
  </section>

  <!-- FEATURES -->
  <section class="features">
    <div class="feature-card">
      <div class="feature-icon">📅</div>
      <h3>Timeline Guide</h3>
      <p>Month-by-month planning from 14 months before to wedding day with prioritized tasks</p>
    </div>
    <div class="feature-card">
      <div class="feature-icon">💰</div>
      <h3>Budget Tracker</h3>
      <p>Track every expense, see where your money goes, and stay within budget</p>
    </div>
    <div class="feature-card">
      <div class="feature-icon">✓</div>
      <h3>Complete Checklist</h3>
      <p>Over 200 tasks organized by category and timeline</p>
    </div>
    <div class="feature-card">
      <div class="feature-icon">📋</div>
      <h3>Vendor Organizer</h3>
      <p>Keep track of all vendors, their contact info, quotes, and deadlines</p>
    </div>
  </section>

  <!-- MAIN CONTENT -->
  <div class="container">
    <section class="section">
      <h2>Why You Need This Wedding Planner</h2>
      <p>Planning a wedding can feel overwhelming. Without proper organization, you'll miss deadlines, overspend your budget, and lose precious peace of mind.</p>

      <p style="margin-top: 15px;">Our <strong>40-page printable wedding planner</strong> solves this problem by:</p>

      <div class="benefits">
        <div class="benefit-item">
          <h4>✓ Saves Time</h4>
          <p>No need to research what to do when. Everything is laid out month by month.</p>
        </div>
        <div class="benefit-item">
          <h4>✓ Saves Money</h4>
          <p>Detailed budget breakdown helps you allocate funds wisely and avoid overspending.</p>
        </div>
        <div class="benefit-item">
          <h4>✓ Reduces Stress</h4>
          <p>Know exactly what to do, when to do it, and never miss a deadline again.</p>
        </div>
        <div class="benefit-item">
          <h4>✓ Keeps Everything Organized</h4>
          <p>One central place for all your wedding planning information and decisions.</p>
        </div>
      </div>
    </section>

    <section class="section">
      <h2>What's Inside (40 Pages)</h2>

      <h3>📅 Planning Timeline</h3>
      <div class="what-included">
        <ul>
          <li>14-month countdown timeline</li>
          <li>6-month express timeline</li>
          <li>3-month quick wedding timeline</li>
          <li>Prioritized monthly tasks</li>
          <li>Key vendor booking deadlines</li>
        </ul>
      </div>

      <h3>💰 Budget Planning</h3>
      <div class="what-included">
        <ul>
          <li>Budget breakdown by category</li>
          <li>$10k, $25k, $50k budget examples</li>
          <li>Monthly expense tracker</li>
          <li>Deposit and payment schedule</li>
          <li>Cost-saving tips for every category</li>
        </ul>
      </div>

      <h3>✓ Wedding Checklist</h3>
      <div class="what-included">
        <ul>
          <li>200+ actionable tasks</li>
          <li>Organized by category</li>
          <li>Checkboxes to track progress</li>
          <li>Notes section for each task</li>
          <li>Printable and fillable pages</li>
        </ul>
      </div>

      <h3>📋 Vendor Organization</h3>
      <div class="what-included">
        <ul>
          <li>Vendor contact tracker</li>
          <li>Quote comparison sheets</li>
          <li>Contract checklist</li>
          <li>Payment schedule tracker</li>
          <li>Important dates and deadlines</li>
        </ul>
      </div>

      <h3>🎨 Design & Details</h3>
      <div class="what-included">
        <ul>
          <li>Color palette planner</li>
          <li>Venue layout guide</li>
          <li>Guest list organizer</li>
          <li>Seating chart template</li>
          <li>Final day-of timeline</li>
        </ul>
      </div>
    </section>
  </div>

  <!-- TESTIMONIALS -->
  <section class="testimonials">
    <div class="testimonials-content">
      <h2>What Brides Are Saying</h2>
      <div class="testimonial-grid">
        <div class="testimonial">
          <div class="stars">★★★★★</div>
          <p class="testimonial-text">"This planner kept me organized and stress-free throughout the entire process. I didn't miss a single deadline!"</p>
          <p class="testimonial-author">- Sarah M., Denver</p>
        </div>
        <div class="testimonial">
          <div class="stars">★★★★★</div>
          <p class="testimonial-text">"The budget tracker saved me hundreds of dollars. I could see exactly where my money was going."</p>
          <p class="testimonial-author">- Jessica K., Seattle</p>
        </div>
        <div class="testimonial">
          <div class="stars">★★★★★</div>
          <p class="testimonial-text">"I printed this out and used it religiously. It's like having a professional wedding planner in your hands."</p>
          <p class="testimonial-author">- Maria G., Austin</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA SECTION -->
  <section class="cta-section">
    <h2>Ready to Plan Your Dream Wedding?</h2>
    <p>Download your free 40-page printable wedding planner today</p>
    <a href="/products/printable-wedding-planner/dist/printable-wedding-planner.pdf" class="cta-button-large" download>📥 Get Your Free Wedding Planner</a>
  </section>

  <!-- FAQ SECTION -->
  <section class="faq-section">
    <h2>Frequently Asked Questions</h2>

    <div class="faq-item active">
      <div class="faq-question">
        <span>Is this planner really free?</span>
        <span>▼</span>
      </div>
      <div class="faq-answer">
        Yes! Our printable wedding planner is completely free to download and use. No hidden fees, no email signup required. Just download and start planning!
      </div>
    </div>

    <div class="faq-item">
      <div class="faq-question">
        <span>Can I print it multiple times?</span>
        <span>▼</span>
      </div>
      <div class="faq-answer">
        Absolutely! You can print as many copies as you need. Print one for yourself, one for your partner, one for your wedding planner - whatever works best for you.
      </div>
    </div>

    <div class="faq-item">
      <div class="faq-question">
        <span>Can I edit the PDF?</span>
        <span>▼</span>
      </div>
      <div class="faq-answer">
        Yes! The PDF has fillable fields so you can edit it digitally before printing. You can also print it blank and write in your information by hand.
      </div>
    </div>

    <div class="faq-item">
      <div class="faq-question">
        <span>What if my wedding is sooner than 14 months?</span>
        <span>▼</span>
      </div>
      <div class="faq-answer">
        The planner includes timelines for 14 months, 6 months, and 3 months. Skip to the section that matches your timeline and adjust as needed.
      </div>
    </div>

    <div class="faq-item">
      <div class="faq-question">
        <span>Is this planner customizable?</span>
        <span>▼</span>
      </div>
      <div class="faq-answer">
        Yes! You can remove pages you don't need, add your own notes, and customize it to match your wedding style and timeline.
      </div>
    </div>

    <div class="faq-item">
      <div class="faq-question">
        <span>Can I share this with my wedding party?</span>
        <span>▼</span>
      </div>
      <div class="faq-answer">
        Of course! Share it with your partner, family members, wedding planner, or anyone helping you plan. The more organized everyone is, the better!
      </div>
    </div>
  </section>
</Layout>

<style>
  /* HERO SECTION */
  .hero {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 80px 20px;
    text-align: center;
  }

  .hero-content {
    max-width: 900px;
    margin: 0 auto;
  }

  .hero h1 {
    font-size: 3em;
    margin-bottom: 20px;
    font-weight: 700;
    line-height: 1.2;
  }

  .hero p {
    font-size: 1.3em;
    margin-bottom: 15px;
    opacity: 0.95;
  }

  .subheading {
    font-size: 1.1em;
    opacity: 0.9;
    font-style: italic;
  }

  .hero-cta {
    margin-top: 40px;
  }

  .badge {
    display: inline-block;
    background: rgba(255,255,255,0.2);
    color: white;
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 0.9em;
    margin-bottom: 15px;
    font-weight: 600;
  }

  .cta-button {
    display: inline-block;
    background: white;
    color: #667eea;
    padding: 18px 40px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 700;
    font-size: 1.1em;
    transition: transform 0.3s, box-shadow 0.3s;
    box-shadow: 0 10px 25px rgba(0,0,0,0.2);
  }

  .cta-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 15px 35px rgba(0,0,0,0.3);
  }

  /* FEATURES */
  .features {
    max-width: 1200px;
    margin: -40px auto 60px;
    padding: 0 20px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 25px;
  }

  .feature-card {
    background: white;
    padding: 30px;
    border-radius: 12px;
    box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    text-align: center;
  }

  .feature-icon {
    font-size: 3em;
    margin-bottom: 15px;
  }

  .feature-card h3 {
    color: #667eea;
    margin-bottom: 10px;
    font-size: 1.2em;
  }

  .feature-card p {
    color: #666;
    font-size: 0.95em;
    line-height: 1.5;
  }

  /* CONTAINER */
  .container {
    max-width: 1000px;
    margin: 60px auto;
    padding: 0 20px;
  }

  .section {
    margin-bottom: 50px;
  }

  .section h2 {
    color: #667eea;
    font-size: 2em;
    margin-bottom: 25px;
    border-bottom: 3px solid #667eea;
    padding-bottom: 15px;
  }

  .section h3 {
    color: #764ba2;
    font-size: 1.3em;
    margin-top: 20px;
    margin-bottom: 12px;
  }

  .what-included {
    background: #f0f4ff;
    border-left: 5px solid #667eea;
    padding: 25px;
    border-radius: 8px;
    margin: 20px 0;
  }

  .what-included ul {
    list-style: none;
    margin-left: 20px;
  }

  .what-included li {
    padding: 10px 0;
    position: relative;
    padding-left: 30px;
  }

  .what-included li:before {
    content: "✓";
    position: absolute;
    left: 0;
    color: #10b981;
    font-weight: bold;
    font-size: 1.2em;
  }

  /* BENEFITS */
  .benefits {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
    margin: 30px 0;
  }

  .benefit-item {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 25px;
    border-radius: 8px;
  }

  .benefit-item h4 {
    margin-bottom: 10px;
    font-size: 1.1em;
  }

  .benefit-item p {
    font-size: 0.95em;
    opacity: 0.95;
  }

  /* TESTIMONIALS */
  .testimonials {
    background: #f8f9fa;
    padding: 50px 20px;
    margin: 50px 0;
  }

  .testimonials-content {
    max-width: 1000px;
    margin: 0 auto;
  }

  .testimonials h2 {
    text-align: center;
    color: #667eea;
    margin-bottom: 40px;
    font-size: 2em;
  }

  .testimonial-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 25px;
  }

  .testimonial {
    background: white;
    padding: 25px;
    border-radius: 8px;
    box-shadow: 0 5px 15px rgba(0,0,0,0.1);
  }

  .stars {
    color: #f59e0b;
    margin-bottom: 10px;
    font-size: 1.2em;
  }

  .testimonial-text {
    font-style: italic;
    color: #666;
    margin-bottom: 15px;
    line-height: 1.6;
  }

  .testimonial-author {
    font-weight: 600;
    color: #333;
  }

  /* CTA */
  .cta-section {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 60px 20px;
    text-align: center;
    margin: 50px 0;
  }

  .cta-section h2 {
    font-size: 2.2em;
    margin-bottom: 20px;
    color: white;
  }

  .cta-section p {
    font-size: 1.1em;
    margin-bottom: 30px;
    opacity: 0.95;
  }

  .cta-button-large {
    display: inline-block;
    background: white;
    color: #667eea;
    padding: 20px 50px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 700;
    font-size: 1.2em;
    transition: transform 0.3s, box-shadow 0.3s;
    box-shadow: 0 10px 30px rgba(0,0,0,0.3);
  }

  .cta-button-large:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 40px rgba(0,0,0,0.4);
  }

  /* FAQ */
  .faq-section {
    max-width: 800px;
    margin: 60px auto;
    padding: 0 20px;
  }

  .faq-section h2 {
    color: #667eea;
    font-size: 2em;
    margin-bottom: 30px;
    text-align: center;
    border-bottom: 3px solid #667eea;
    padding-bottom: 15px;
  }

  .faq-item {
    background: white;
    margin-bottom: 15px;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  }

  .faq-question {
    background: #f0f4ff;
    padding: 18px;
    cursor: pointer;
    font-weight: 600;
    color: #667eea;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .faq-question:hover {
    background: #e8ecff;
  }

  .faq-answer {
    padding: 20px;
    color: #666;
    line-height: 1.6;
    display: none;
  }

  .faq-item.active .faq-answer {
    display: block;
  }

  @media (max-width: 768px) {
    .hero h1 {
      font-size: 2em;
    }

    .feature-card {
      padding: 20px;
    }
  }
</style>

<script>
  // FAQ Toggle
  document.querySelectorAll('.faq-question').forEach(question => {
    question.addEventListener('click', function() {
      this.parentElement.classList.toggle('active');
    });
  });
</script>
