---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import checklistsData from '../../data/categorized-checklists.json';

const seo = {
  title: '$20,000 Wedding Budget Checklist & Breakdown (2026)',
  description: 'Full $20,000 wedding budget breakdown for 75-100 guests: category percentages, dollar amounts, a booking sequence, and 7 ways to save more.',
  canonical: 'https://www.weddingplanningchecklists.org/checklists/wedding-budget-calculator-20k',
  image: '/20k-wedding-budget-overview.jpg'
};

const breadcrumbItems = [
  { name: 'Home', item: 'https://www.weddingplanningchecklists.org/' },
  { name: 'Checklists', item: 'https://www.weddingplanningchecklists.org/#categorized-checklists' },
  { name: '$20,000 Wedding Budget Checklist', item: seo.canonical }
];

const faqs = [
  {
    q: 'Is $20,000 a realistic wedding budget in 2026?',
    a: 'Yes. A $20,000 wedding budget is close to the national median and comfortably supports 75-100 guests with a professional venue, licensed caterer, photographer, DJ, and florist when the budget is allocated using standard category percentages.'
  },
  {
    q: 'How many guests can I invite on a $20,000 wedding budget?',
    a: 'Most couples at this budget level comfortably host 75-100 guests, which works out to roughly $200-$265 per guest across venue, food, bar, and rentals.'
  },
  {
    q: "What's the biggest expense in a $20,000 wedding budget?",
    a: 'Venue and food together, at 45% or about $9,000, are consistently the largest line item, since they scale directly with guest count.'
  },
  {
    q: 'Should I include a live band in a $20,000 wedding budget?',
    a: 'A live band typically costs $2,000-$4,000, which would consume the entire photography and entertainment category on its own. Most couples at this budget tier choose a DJ instead and redirect the savings toward photography hours or the bar package.'
  },
  {
    q: 'How much should I set aside for a wedding budget emergency fund?',
    a: 'Plan for 3-5% of your total budget as an emergency buffer. At this level, that\'s $600-$1,000 set aside for vendor price changes, weather contingencies, or last-minute rental needs.'
  },
  {
    q: 'Can I customize this $20,000 wedding budget checklist for my own priorities?',
    a: 'Yes. The percentages here are a starting framework, not a fixed formula. Use the Wedding Budget Calculator to reallocate funds toward whichever category matters most to you, whether that\'s photography, florals, or the bar package.'
  }
];

const schemaData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      'headline': '$20,000 Wedding Budget Checklist: Complete Breakdown for 75-100 Guests (2026)',
      'description': 'Balanced budget breakdown template for a 75-100 guest wedding with professional vendors.',
      'image': 'https://www.weddingplanningchecklists.org/20k-wedding-budget-overview.jpg',
      'author': {
        '@type': 'Person',
        'name': 'Sarah Jenkins'
      },
      'publisher': {
        '@type': 'Organization',
        'name': 'WeddingPlanningChecklists.org',
        'url': 'https://www.weddingplanningchecklists.org/'
      },
      'mainEntityOfPage': 'https://www.weddingplanningchecklists.org/checklists/wedding-budget-calculator-20k',
      'datePublished': '2026-09-06',
      'dateModified': '2026-09-11'
    },
    {
      '@type': 'FAQPage',
      'mainEntity': faqs.map(faq => ({
        '@type': 'Question',
        'name': faq.q,
        'acceptedAnswer': {
          '@type': 'Answer',
          'text': faq.a
        }
      }))
    },
    {
      '@type': 'HowTo',
      'name': 'How to Allocate a $20,000 Wedding Budget',
      'step': [
        {
          '@type': 'HowToStep',
          'name': 'Venue & Food',
          'text': 'Allocate 45% ($9,000) to venue rental and catering.'
        },
        {
          '@type': 'HowToStep',
          'name': 'Photography & Entertainment',
          'text': 'Allocate 20% ($4,000) to photography and a DJ or live act.'
        },
        {
          '@type': 'HowToStep',
          'name': 'Florals & Attire',
          'text': 'Allocate 20% ($4,000) to attire and floral arrangements.'
        },
        {
          '@type': 'HowToStep',
          'name': 'Stationery & Miscellaneous',
          'text': 'Allocate 15% ($3,000) to stationery, favors, and an emergency fund.'
        }
      ]
    },
    {
      '@type': 'BreadcrumbList',
      'itemListElement': breadcrumbItems.map((item, idx) => ({
        '@type': 'ListItem',
        'position': idx + 1,
        'name': item.name,
        'item': item.item
      }))
    }
  ]
};

const combinedSchema = JSON.stringify(schemaData);

const budgetTable = [
  { category: 'Venue & Food', percent: '45%', amount: '$9,000', details: 'All-inclusive banquet hall, vineyard, or similar package with tables, chairs, and basic linens' },
  { category: 'Photography & Entertainment', percent: '20%', amount: '$4,000', details: '6-8 hours of photography plus a DJ or small live act' },
  { category: 'Florals & Attire', percent: '20%', amount: '$4,000', details: 'Gown, suit, alterations, bouquet, and centerpieces' },
  { category: 'Stationery & Miscellaneous', percent: '15%', amount: '$3,000', details: 'Invitations, favors, officiant fee, and emergency buffer' }
];

const tocItems = [
  { id: 'quick-overview', label: 'Quick Overview' },
  { id: 'what-it-covers', label: 'What $20,000 Realistically Covers' },
  { id: 'who-it-fits', label: 'Who This Budget Tier Fits Best' },
  { id: 'budget-breakdown', label: 'Complete Breakdown by Category' },
  { id: 'category-deep-dives', label: 'Category Deep Dives' },
  { id: 'spending-sequence', label: 'How to Sequence Your Budget' },
  { id: 'stretch-budget', label: '7 Ways to Stretch Budget Further' },
  { id: 'budget-shifts', label: '$20K vs. $10K vs. $30K Shifts' },
  { id: 'faqs', label: 'Frequently Asked Questions' },
  { id: 'final-thoughts', label: 'Final Thoughts & Next Steps' }
];

const relatedChecklists = checklistsData.checklists.filter(c => c.slug !== 'wedding-budget-calculator-20k').slice(0, 4);
---

<BaseLayout 
  title={seo.title} 
  description={seo.description} 
  canonical={seo.canonical} 
  image={seo.image}
  type="article"
  schemaScript={combinedSchema}
>
  <Header />

  <!-- ═══════════════════════════════════════════════
       READING PROGRESS BAR
       ═══════════════════════════════════════════════ -->
  <div id="reading-progress" class="reading-progress-bar" style="width: 0%"></div>

  <!-- ═══════════════════════════════════════════════
       HERO HEADER SECTION
       ═══════════════════════════════════════════════ -->
  <header class="relative pt-10 pb-14 bg-gradient-to-b from-[#FCECF0]/60 via-white to-transparent overflow-hidden">
    <!-- Decorative Background Elements -->
    <div class="absolute top-0 right-0 w-96 h-96 bg-gradient-to-bl from-[#FCECF0]/40 to-transparent rounded-full blur-3xl -z-10"></div>
    <div class="absolute bottom-0 left-0 w-64 h-64 bg-gradient-to-tr from-[#F3E8EA]/30 to-transparent rounded-full blur-3xl -z-10"></div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-5">
      
      <!-- 1. Breadcrumb Navigation -->
      <nav class="flex items-center justify-center gap-2 text-xs font-semibold text-slate-500" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[#B76E79] transition-colors inline-flex items-center gap-1">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
          Home
        </a>
        <svg class="w-3 h-3 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        <a href="/#categorized-checklists" class="hover:text-[#B76E79] transition-colors">Checklists</a>
        <svg class="w-3 h-3 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        <span class="text-[#B76E79] truncate max-w-[200px] sm:max-w-xs">$20K Budget Checklist</span>
      </nav>

      <!-- 2. Category Badge & Read Time -->
      <div class="flex items-center justify-center gap-3 text-xs font-bold">
        <span class="bg-gradient-to-r from-[#B76E79] to-[#a25d66] text-white px-4 py-1.5 rounded-full uppercase tracking-wider shadow-sm">
          💰 Budget Guide
        </span>
        <span class="text-slate-300">•</span>
        <span class="bg-[#FCECF0] text-[#B76E79] px-3.5 py-1 rounded-full uppercase tracking-wider text-[11px] font-bold">
          Popular Budget
        </span>
        <span class="text-slate-300">•</span>
        <span class="text-slate-600 inline-flex items-center gap-1">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          8 min read
        </span>
      </div>

      <!-- 3. H1 Title -->
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-[#1A1A1A] leading-tight tracking-tight max-w-3xl mx-auto" style="font-family: 'Playfair Display', serif;">
        $20,000 Wedding Budget Checklist: Complete Breakdown for 75-100 Guests (2026)
      </h1>

      <!-- 4. Subtitle / Intro Lead -->
      <p class="text-base sm:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed">
        A $20,000 wedding budget sits right at the national median, and it's enough to host a genuinely beautiful, well-vendored wedding for 75-100 guests without cutting corners on the things guests actually notice. The trick isn't spending less everywhere — it's spending correctly.
      </p>

      <!-- 5. Author & Date Meta -->
      <div class="flex items-center justify-center gap-2 sm:gap-4 flex-wrap text-xs text-slate-500 font-medium pt-2">
        <span class="inline-flex items-center gap-2">
          <div class="w-7 h-7 rounded-full bg-gradient-to-br from-[#B76E79] to-[#a25d66] text-white flex items-center justify-center text-[10px] font-bold shadow-sm">SJ</div>
          By <strong class="text-[#1A1A1A]">Sarah Jenkins</strong>
        </span>
        <span class="text-slate-300">|</span>
        <span class="inline-flex items-center gap-1">
          <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
          Last Updated: September 11, 2026
        </span>
      </div>
    </div>
  </header>

  <!-- ═══════════════════════════════════════════════
       HERO IMAGE
       ═══════════════════════════════════════════════ -->
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 -mt-6 mb-12 relative">
    <div class="rounded-2xl lg:rounded-3xl overflow-hidden shadow-xl border border-white/60 bg-white group">
      <img 
        src="/20k-wedding-budget-overview.jpg" 
        alt="Wedding budget planning notebook and calculator for a $20,000 wedding" 
        class="w-full h-auto max-h-[520px] object-cover group-hover:scale-[1.02] transition-transform duration-700" 
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <p class="text-center text-[11px] text-slate-500 mt-2.5 italic">
      Wedding budget planning notebook and calculator for a $20,000 wedding.
    </p>
  </div>

  <!-- ═══════════════════════════════════════════════
       MOBILE TABLE OF CONTENTS DRAWER
       ═══════════════════════════════════════════════ -->
  <div class="lg:hidden max-w-5xl mx-auto px-4 sm:px-6 mb-8">
    <button 
      id="mobile-toc-toggle" 
      class="w-full flex items-center justify-between bg-white border border-[#F3E8EA] rounded-2xl px-5 py-3.5 shadow-sm hover:shadow-md transition-all"
      aria-expanded="false"
      aria-controls="mobile-toc-panel"
    >
      <span class="flex items-center gap-2 text-sm font-bold text-[#1A1A1A]">
        <svg class="w-4 h-4 text-[#B76E79]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path></svg>
        In This $20K Checklist Guide
      </span>
      <svg id="mobile-toc-chevron" class="w-4 h-4 text-slate-400 faq-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
    </button>
    <div id="mobile-toc-panel" class="mobile-toc-panel bg-white border border-t-0 border-[#F3E8EA] rounded-b-2xl shadow-sm">
      <nav class="p-4 space-y-1">
        {tocItems.map(item => (
          <a href={`#${item.id}`} class="block text-sm font-medium text-slate-600 hover:text-[#B76E79] transition-colors py-1.5 pl-3 border-l-2 border-transparent hover:border-[#B76E79] rounded-r-lg">
            {item.label}
          </a>
        ))}
      </nav>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════
       MAIN 2-COLUMN CONTENT GRID
       ═══════════════════════════════════════════════ -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-24 grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14">
    
    <!-- ─── STICKY SIDEBAR (LEFT) ─── -->
    <aside class="col-span-1 lg:col-span-4 xl:col-span-3 hidden lg:block">
      <div class="sticky top-24 space-y-6">

        <!-- Dynamic Table of Contents -->
        <div class="bg-white p-5 rounded-2xl border border-[#F3E8EA] shadow-sm">
          <h3 class="font-bold text-xs text-[#1A1A1A] uppercase tracking-wider mb-4 pb-2 border-b border-slate-100 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-gradient-to-r from-[#B76E79] to-[#D4AF37]"></span> 
            Checklist Contents
          </h3>
          <nav id="sidebar-toc" class="space-y-0.5 text-xs font-semibold text-slate-600">
            {tocItems.map(item => (
              <a 
                href={`#${item.id}`} 
                class="toc-link block py-1.5 pl-3 rounded-r-lg"
                data-toc-id={item.id}
              >
                {item.label}
              </a>
            ))}
          </nav>
        </div>

        <!-- Interactive Dashboard Tool CTA Box -->
        <div class="bg-gradient-to-br from-[#1A1A1A] via-slate-900 to-[#2d2d2d] text-white p-6 rounded-2xl text-center space-y-4 shadow-lg relative overflow-hidden">
          <div class="absolute top-2 right-2 w-16 h-16 bg-[#B76E79]/10 rounded-full blur-xl"></div>
          <span class="text-[10px] font-bold uppercase tracking-widest text-[#D4AF37] block">Free Interactive Tool</span>
          <h4 class="font-bold text-sm leading-snug relative">Track This Checklist Live</h4>
          <p class="text-[11px] text-slate-400 leading-relaxed relative">
            Check off tasks, track RSVPs, log vendor deposits, and monitor your remaining balance in real time.
          </p>
          <a 
            href="/tools/wedding-planning-dashboard" 
            class="block w-full bg-gradient-to-r from-[#B76E79] to-[#a25d66] hover:from-[#a25d66] hover:to-[#B76E79] text-white py-2.5 rounded-xl text-xs font-bold transition-all shadow-md relative"
          >
            Open Live Dashboard →
          </a>
        </div>

        <!-- Budget Calculator Card -->
        <div class="bg-white border border-[#F3E8EA] p-5 rounded-2xl shadow-sm space-y-3">
          <div class="flex items-center gap-2">
            <span class="text-base">💰</span>
            <h4 class="font-bold text-xs uppercase tracking-wider text-[#1A1A1A]">Budget Calculator</h4>
          </div>
          <p class="text-xs text-slate-600 leading-relaxed">
            Run your custom figures, test alternative guest counts, and calculate per-head costs instantly.
          </p>
          <a 
            href="/tools/budget-calculator" 
            class="block text-center bg-[#FCECF0] hover:bg-[#B76E79] text-[#B76E79] hover:text-white font-bold py-2 rounded-xl text-xs transition-all"
          >
            Run Your Numbers →
          </a>
        </div>

        <!-- Quick Planning Tools Links -->
        <div class="bg-white rounded-2xl border border-[#F3E8EA] p-5 shadow-sm space-y-3">
          <h4 class="font-bold text-xs uppercase tracking-wider text-[#1A1A1A]">Planning Tools</h4>
          <ul class="space-y-1.5 text-xs font-medium">
            <li>
              <a href="/tools/wedding-planning-timeline" class="text-slate-600 hover:text-[#B76E79] flex items-center justify-between py-1.5 border-b border-slate-100 transition-colors">
                <span>📅 Wedding Planning Timeline</span>
                <span>→</span>
              </a>
            </li>
            <li>
              <a href="/tools/budget-calculator" class="text-slate-600 hover:text-[#B76E79] flex items-center justify-between py-1.5 border-b border-slate-100 transition-colors">
                <span>💰 Budget Calculator</span>
                <span>→</span>
              </a>
            </li>
            <li>
              <a href="/tools/guest-list-manager" class="text-slate-600 hover:text-[#B76E79] flex items-center justify-between py-1.5 border-b border-slate-100 transition-colors">
                <span>👥 Guest List Manager</span>
                <span>→</span>
              </a>
            </li>
            <li>
              <a href="/tools/timeline-generator" class="text-slate-600 hover:text-[#B76E79] flex items-center justify-between py-1.5 transition-colors">
                <span>⏰ Timeline Generator</span>
                <span>→</span>
              </a>
            </li>
          </ul>
        </div>

      </div>
    </aside>

    <!-- ─── MAIN ARTICLE COLUMN (RIGHT) ─── -->
    <article class="col-span-1 lg:col-span-8 xl:col-span-9 space-y-10">
      
      <!-- ═══ QUICK ANSWER / SUMMARY BOX ═══ -->
      <section id="quick-overview" class="relative bg-gradient-to-r from-[#FCECF0] via-white to-[#FCECF0]/50 border border-[#F3E8EA] p-6 sm:p-8 rounded-2xl shadow-sm">
        <div class="flex items-start gap-3">
          <div class="shrink-0 w-10 h-10 rounded-xl bg-gradient-to-br from-[#B76E79] to-[#a25d66] text-white flex items-center justify-center shadow-sm">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <div class="space-y-2">
            <h3 class="font-bold text-sm text-[#1A1A1A] uppercase tracking-wider">Quick Overview</h3>
            <p class="text-sm sm:text-base text-slate-700 leading-relaxed font-medium">
              A $20,000 wedding budget sits right at the national median, and it's enough to host a genuinely beautiful, well-vendored wedding for 75-100 guests without cutting corners on the things guests actually notice. The trick isn't spending less everywhere — it's spending correctly. This checklist breaks that total into the same four categories real couples use, shows you what each dollar buys at this budget tier, and flags where couples typically overspend before they've even booked a venue.
            </p>
          </div>
        </div>
      </section>

      <!-- ═══ KEY TAKEAWAYS ═══ -->
      <section class="bg-white border border-[#F3E8EA] p-6 sm:p-8 rounded-2xl shadow-sm space-y-4 relative overflow-hidden">
        <div class="absolute left-0 top-0 bottom-0 w-1 bg-gradient-to-b from-[#B76E79] via-[#D4AF37] to-[#B76E79]"></div>
        <h3 class="font-bold text-sm text-[#1A1A1A] uppercase tracking-wider flex items-center gap-2 pl-4">
          <span class="text-[#D4AF37] text-lg">⚡</span> Key Takeaways for 75–100 Guests
        </h3>
        <ul class="space-y-3 pl-4 text-sm text-slate-700 font-medium">
          <li class="flex items-start gap-3">
            <span class="shrink-0 mt-0.5 w-5 h-5 rounded-full bg-[#FCECF0] text-[#B76E79] flex items-center justify-center text-[10px] font-bold">✓</span>
            <span class="leading-relaxed"><strong>Per-Guest Target:</strong> Planning for 75–100 guests works out to $200–$265 per head across all categories.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="shrink-0 mt-0.5 w-5 h-5 rounded-full bg-[#FCECF0] text-[#B76E79] flex items-center justify-center text-[10px] font-bold">✓</span>
            <span class="leading-relaxed"><strong>Venue & Food Anchor:</strong> 45% ($9,000) dedicated to full-service catering, room rental, and beer/wine open bar.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="shrink-0 mt-0.5 w-5 h-5 rounded-full bg-[#FCECF0] text-[#B76E79] flex items-center justify-center text-[10px] font-bold">✓</span>
            <span class="leading-relaxed"><strong>Photo & Entertainment:</strong> 20% ($4,000) funds 6–8 hours of professional photography and a full-event DJ.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="shrink-0 mt-0.5 w-5 h-5 rounded-full bg-[#FCECF0] text-[#B76E79] flex items-center justify-center text-[10px] font-bold">✓</span>
            <span class="leading-relaxed"><strong>Non-Negotiable Buffer:</strong> Keep $500–$800 cushion inside the Miscellaneous line for surprise fees and vendor tip additions.</span>
          </li>
        </ul>
      </section>

      <!-- ═══ LUXURY ARTICLE CONTENT CONTAINER ═══ -->
      <div class="article-content">
        
        <!-- SECTION 1: What a $20,000 Wedding Budget Realistically Covers -->
        <section id="what-it-covers">
          <h2>What a $20,000 Wedding Budget Realistically Covers</h2>
          <p>
            At $20,000, you're planning for roughly 75-100 guests, which works out to $200-$265 per guest once every category is accounted for. That per-guest figure matters more than the total, because it's what determines whether your venue, catering, and bar choices are realistic. This budget tier typically covers a full-service or all-inclusive venue, a licensed caterer, an open bar for beer and wine, professional photography for six to eight hours, a DJ or small live act, a mid-range gown and suit, and a florist for centerpieces and a bouquet.
          </p>
          <p>
            What it usually doesn't stretch to cover comfortably: a live band, videography on top of photography, a guest list over 100, or a Saturday date at a premium venue in a major metro area.
          </p>

          <blockquote>
            "At $20,000, per-guest math ($200–$265/head) dictates your decisions. Choose an all-inclusive venue or Friday/Sunday date to prevent runaway rental bills."
          </blockquote>
        </section>

        <!-- SECTION 2: Who This Budget Tier Fits Best -->
        <section id="who-it-fits">
          <h2>Who This Budget Tier Fits Best</h2>
          <p>
            This budget tends to fit couples who want professional vendors across the board but don't need a luxury venue or a guest list over 100. It works well for a mid-size hometown wedding, a weekday or off-season celebration at a nicer venue, or a couple who's prioritizing food and photography over florals and favors.
          </p>
          <p>
            If your guest list is closer to 150 or you're set on a Saturday date at a premium venue in a major city, you'll likely want to look at the <a href="/checklists/wedding-budget-calculator-30k">$30,000 wedding budget</a> tier instead — the math simply gets tighter as guest count and venue prestige climb. On the other end, couples hosting under 50 guests often find that a <a href="/checklists/wedding-budget-calculator-10k">$10,000 wedding budget</a> covers the same vendor quality at a smaller scale.
          </p>
        </section>

        <!-- SECTION 3: Complete $20,000 Wedding Budget Breakdown by Category -->
        <section id="budget-breakdown">
          <h2>Complete $20,000 Wedding Budget Breakdown by Category</h2>
          <p>
            Here's how a $20,000 wedding budget checklist typically divides across the four categories that make up nearly every wedding cost.
          </p>

          <figure class="my-6">
            <img 
              src="/20k-budget-category-split.jpg" 
              alt="Four budget categories for a 20000 dollar wedding shown as labeled envelopes" 
              class="max-w-md mx-auto block"
              loading="lazy"
            />
            <figcaption class="text-center text-xs text-slate-500 mt-2 italic">
              Four budget categories for a 20000 dollar wedding shown as labeled envelopes.
            </figcaption>
          </figure>

          <!-- Budget Breakdown Table -->
          <table>
            <thead>
              <tr>
                <th>Category</th>
                <th style="text-align: center;">Percentage</th>
                <th style="text-align: right;">Dollar Amount</th>
                <th>What's Included</th>
              </tr>
            </thead>
            <tbody>
              {budgetTable.map(item => (
                <tr>
                  <td><strong>{item.category}</strong></td>
                  <td style="text-align: center;">
                    <span class="inline-block bg-[#FCECF0] text-[#B76E79] font-bold px-2.5 py-0.5 rounded-full text-xs">
                      {item.percent}
                    </span>
                  </td>
                  <td style="text-align: right; font-weight: 700; color: #1A1A1A;">{item.amount}</td>
                  <td style="font-size: 0.85rem; color: #475569;">{item.details}</td>
                </tr>
              ))}
              <tr style="background: #FCECF0; font-weight: 800; border-top: 2px solid #B76E79;">
                <td><strong>Total</strong></td>
                <td style="text-align: center;"><strong>100%</strong></td>
                <td style="text-align: right; color: #B76E79; font-size: 1.05rem;"><strong>$20,000</strong></td>
                <td style="font-size: 0.85rem; font-weight: 600;">Complete 4-category framework</td>
              </tr>
            </tbody>
          </table>
        </section>

        <!-- SECTION 4: Category Deep Dives -->
        <section id="category-deep-dives">
          <h2>Category Deep Dives</h2>

          <h3>Venue & Food (45% — $9,000)</h3>
          <p>
            Venue and catering absorb nearly half of the total, and that's intentional — it's the one category guests interact with for the entire event. At this tier, an all-inclusive banquet space or a vineyard package that bundles the room, tables, chairs, and basic linens is usually the most efficient choice, since it avoids the hidden rental fees that catch couples off guard later.
          </p>
          <p>
            Budget roughly $9,000 for the venue rental, plated or buffet catering for 75-100 guests, and a house beer-and-wine bar. Booking an off-peak date (a Friday evening or a Sunday brunch wedding) can free up $1,000-$2,000 to move toward photography or florals.
          </p>

          <figure>
            <img 
              src="/20k-wedding-venue-reception.jpg" 
              alt="All-inclusive wedding reception venue set for 75 to 100 guests" 
              loading="lazy"
            />
            <figcaption class="text-center text-xs text-slate-500 mt-2 italic">
              All-inclusive wedding reception venue set for 75 to 100 guests with elegant banquet dining tables.
            </figcaption>
          </figure>

          <h3>Photography & Entertainment (20% — $4,000)</h3>
          <p>
            Photography and entertainment together claim about $4,000 of the total. Six to eight hours of coverage from a professional photographer typically runs $2,000-$2,800 at this tier, which is enough for getting-ready shots, the ceremony, and several hours of the reception.
          </p>
          <p>
            A DJ with their own sound system and lighting generally costs $800-$1,200, and is the more budget-efficient entertainment choice compared to a live band, which can easily double that cost. If videography matters to you, plan to trim 5-10% from florals or stationery to fit it in rather than treating it as a free add-on.
          </p>

          <figure>
            <img 
              src="/20k-wedding-photographer-dj.jpg" 
              alt="Wedding DJ setup and camera representing photography and entertainment budget" 
              loading="lazy"
            />
            <figcaption class="text-center text-xs text-slate-500 mt-2 italic">
              Wedding DJ setup and camera representing photography and entertainment budget.
            </figcaption>
          </figure>

          <h3>Florals & Attire (20% — $4,000)</h3>
          <p>
            Attire and florals share roughly $4,000 in a $20,000 wedding budget checklist. A designer or boutique gown with alterations typically runs $1,200-$1,800, a suit or tuxedo rental or purchase adds $400-$600, and a florist handling a bridal bouquet plus 8-10 centerpieces usually costs $1,500-$2,000.
          </p>
          <p>
            Reusing ceremony florals as reception decor and choosing in-season blooms are the two changes that make the biggest dent in this category without changing the overall look.
          </p>

          <figure>
            <img 
              src="/20k-wedding-florals-attire.jpg" 
              alt="Bridal bouquet and suit representing wedding florals and attire budget" 
              loading="lazy"
            />
            <figcaption class="text-center text-xs text-slate-500 mt-2 italic">
              Bridal bouquet and suit representing wedding florals and attire budget.
            </figcaption>
          </figure>

          <h3>Stationery & Miscellaneous (15% — $3,000)</h3>
          <p>
            The remaining 15%, about $3,000, covers custom invitations and save-the-dates, guest favors, the officiant's fee, marriage license, hair and makeup trials, and — critically — an emergency fund.
          </p>
          <p>
            Couples working from a $20,000 wedding budget should treat the emergency buffer as non-negotiable rather than optional; a $500-$800 cushion inside this category absorbs the vendor price increases and last-minute rental needs that show up on almost every wedding.
          </p>
        </section>

        <!-- SECTION 5: How to Sequence Your $20,000 Wedding Budget Across Your Planning Timeline -->
        <section id="spending-sequence">
          <h2>How to Sequence Your $20,000 Wedding Budget Across Your Planning Timeline</h2>
          <p>
            Spending order matters as much as category allocation. Booking your venue and caterer first locks in 45% of your total early, which makes every later decision easier because you know exactly what's left. A workable sequence looks like this:
          </p>

          <ol>
            <li>
              <strong>12-10 months out:</strong> Book venue, caterer, and photographer (uses roughly 65% of budget) — the <a href="/checklists/wedding-vendor-booking-checklist">Vendor Booking Checklist</a> is useful here for tracking contracts and deposit due dates.
            </li>
            <li>
              <strong>9-7 months out:</strong> Book DJ or band, florist, and order the gown or suit.
            </li>
            <li>
              <strong>6-4 months out:</strong> Order invitations, finalize the bar package, book hair and makeup.
            </li>
            <li>
              <strong>3-1 months out:</strong> Order favors, confirm final headcount with the caterer, release remaining emergency funds if unused.
            </li>
          </ol>

          <p>
            Pairing this sequence with a <a href="/checklists/12-month-wedding-planning-checklist">12-Month Wedding Planning Checklist</a> or the <a href="/tools/wedding-planning-timeline">Wedding Planning Timeline</a> tool keeps your spending and your task list moving together, instead of booking vendors faster than you can actually pay deposits. Most venues and caterers require a deposit of 25-50% at booking, so it helps to know roughly when each deposit is due before you commit to a date — a $9,000 venue and catering package might mean a $3,000-$4,500 deposit the same month you sign the contract.
          </p>

          <figure>
            <img 
              src="/20k-wedding-budget-timeline.jpg" 
              alt="Wedding budget planning checklist and calendar for booking vendors in order" 
              loading="lazy"
            />
            <figcaption class="text-center text-xs text-slate-500 mt-2 italic">
              Wedding budget planning checklist and calendar for booking vendors in order.
            </figcaption>
          </figure>
        </section>

        <!-- SECTION 6: 7 Ways to Stretch a $20,000 Wedding Budget Further -->
        <section id="stretch-budget">
          <h2>7 Ways to Stretch a $20,000 Wedding Budget Further</h2>
          <p>
            A $20,000 wedding budget goes noticeably further with a handful of proven adjustments:
          </p>

          <ul>
            <li>
              <strong>Choose a Friday or Sunday date instead of a Saturday:</strong> many venues discount 10-20% for off-peak days, and caterers sometimes waive minimums on weekday bookings.
            </li>
            <li>
              <strong>Cap the guest list at 75 rather than 100:</strong> every 10 guests removed frees up roughly $600-$800 across food and bar costs, since per-head catering and bar pricing scale directly with headcount.
            </li>
            <li>
              <strong>Pick an all-inclusive venue over separate ceremony and reception sites:</strong> which eliminates a second site fee, a second setup crew, and often a second insurance requirement entirely.
            </li>
            <li>
              <strong>Serve beer and wine instead of a full open bar:</strong> this alone can save $1,000-$1,500 for 75-100 guests, and most caterers can quote both options side by side so you can compare directly.
            </li>
            <li>
              <strong>Book a DJ instead of a live band for entertainment:</strong> a DJ typically covers ceremony music, cocktail hour, and reception in one flat fee, where a band often charges separately for each.
            </li>
            <li>
              <strong>Choose in-season, locally available flowers:</strong> and reuse ceremony arrangements at the reception rather than ordering two separate sets of florals.
            </li>
            <li>
              <strong>Order printed invitations from a template:</strong> rather than fully custom stationery design — the printing and paper costs are nearly identical, but the design fee disappears.
            </li>
          </ul>
        </section>

        <!-- SECTION 7: $20,000 vs. $10,000 vs. $30,000: How the Budget Shifts -->
        <section id="budget-shifts">
          <h2>$20,000 vs. $10,000 vs. $30,000: How the Budget Shifts</h2>
          <p>
            The category percentages in a wedding budget checklist don't stay fixed as the total changes — they shift because some costs, like photography and the officiant fee, are close to flat regardless of budget size.
          </p>

          <!-- Budget Comparison Table -->
          <table>
            <thead>
              <tr>
                <th>Budget Tier</th>
                <th style="text-align: center;">Guest Count</th>
                <th>Venue & Food</th>
                <th>Photo & Ent.</th>
                <th>Florals & Attire</th>
                <th>Stationery & Misc</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>$10,000</strong></td>
                <td style="text-align: center;">40-50</td>
                <td>40% ($4,000)</td>
                <td>20% ($2,000)</td>
                <td>20% ($2,000)</td>
                <td>20% ($2,000)</td>
              </tr>
              <tr style="background: #FCECF0; font-weight: 700;">
                <td><strong style="color: #B76E79;">$20,000</strong></td>
                <td style="text-align: center;"><strong>75-100</strong></td>
                <td><strong>45% ($9,000)</strong></td>
                <td><strong>20% ($4,000)</strong></td>
                <td><strong>20% ($4,000)</strong></td>
                <td><strong>15% ($3,000)</strong></td>
              </tr>
              <tr>
                <td><strong>$30,000</strong></td>
                <td style="text-align: center;">100-125</td>
                <td>48% ($14,400)</td>
                <td>18% ($5,400)</td>
                <td>19% ($5,700)</td>
                <td>15% ($4,500)</td>
              </tr>
            </tbody>
          </table>

          <p>
            Moving from a <a href="/checklists/wedding-budget-calculator-10k">$10,000 wedding budget</a> to this tier roughly doubles the guest count you can comfortably host, while the venue and food share of the pie actually grows, because feeding twice as many guests costs more than the fixed costs (photography, officiant, stationery) increase.
          </p>
          <p>
            Couples considering a <a href="/checklists/wedding-budget-calculator-30k">$30,000 wedding budget</a> will notice stationery and miscellaneous costs level off in dollar terms relative to guest count, since favors and invitations scale with headcount but licensing and officiant fees don't.
          </p>
        </section>

        <!-- SECTION 8: Final Thoughts -->
        <section id="final-thoughts">
          <h2>Final Thoughts</h2>
          <p>
            A $20,000 wedding budget works best when the big three — venue, food, and bar — are booked first and everything else is built around what's left. Use the category breakdown above as your starting checklist, then track every deposit and payment against it as vendors get booked.
          </p>

          <blockquote>
            Pair this checklist with the free <a href="/tools/budget-calculator">Wedding Budget Calculator</a> to model your own guest count and priorities, or map it against a full 12-month planning checklist to put your spending on a clear timeline.
          </blockquote>
        </section>

