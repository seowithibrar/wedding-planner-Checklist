  <script>
    document.addEventListener('DOMContentLoaded', () => {

      // Reading Progress Bar
      const progressBar = document.getElementById('reading-progress');
      if (progressBar) {
        window.addEventListener('scroll', () => {
          const scrollTop = window.scrollY;
          const docHeight = document.documentElement.scrollHeight - window.innerHeight;
          const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
          progressBar.style.width = `${Math.min(progress, 100)}%`;
        }, { passive: true });
      }

      // Back to Top Button
      const backToTop = document.getElementById('back-to-top');
      if (backToTop) {
        window.addEventListener('scroll', () => {
          if (window.scrollY > 500) {
            backToTop.classList.add('visible');
          } else {
            backToTop.classList.remove('visible');
          }
        }, { passive: true });
        backToTop.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }

      // Social Share Bar Visibility
      const shareBar = document.getElementById('social-share');
      if (shareBar) {
        window.addEventListener('scroll', () => {
          if (window.scrollY > 400) {
            shareBar.classList.add('visible');
          } else {
            shareBar.classList.remove('visible');
          }
        }, { passive: true });
      }

      // Copy Link Button
      const copyBtn = document.getElementById('copy-link-btn');
      if (copyBtn) {
        copyBtn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(window.location.href);
            copyBtn.innerHTML = '<svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>';
            setTimeout(() => {
              copyBtn.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path></svg>';
            }, 2000);
          } catch {}
        });
      }

      // Mobile TOC Drawer
      const mobileTocToggle = document.getElementById('mobile-toc-toggle');
      const mobileTocPanel = document.getElementById('mobile-toc-panel');
      const mobileTocChevron = document.getElementById('mobile-toc-chevron');
      if (mobileTocToggle && mobileTocPanel) {
        mobileTocToggle.addEventListener('click', () => {
          const isOpen = mobileTocPanel.classList.toggle('open');
          mobileTocToggle.setAttribute('aria-expanded', String(isOpen));
          if (mobileTocChevron) mobileTocChevron.classList.toggle('rotated', isOpen);
        });
        mobileTocPanel.querySelectorAll('a').forEach(link => {
          link.addEventListener('click', () => {
            mobileTocPanel.classList.remove('open');
            mobileTocToggle.setAttribute('aria-expanded', 'false');
            if (mobileTocChevron) mobileTocChevron.classList.remove('rotated');
          });
        });
      }

      // FAQ Accordion
      document.querySelectorAll('.faq-toggle').forEach(btn => {
        btn.addEventListener('click', () => {
          const faqItem = btn.closest('.faq-item');
          if (!faqItem) return;
          const answer = faqItem.querySelector('.faq-answer');
          const chevron = btn.querySelector('.faq-chevron');
          const isOpen = answer?.classList.toggle('open');
          btn.setAttribute('aria-expanded', String(!!isOpen));
          chevron?.classList.toggle('rotated', !!isOpen);
        });
      });

      // Sidebar TOC Active Section Tracking
      const tocLinks = document.querySelectorAll('#sidebar-toc .toc-link');
      if (tocLinks.length > 0) {
        const observerOptions = { rootMargin: '-80px 0px -70% 0px', threshold: 0 };
        const tocObserver = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              tocLinks.forEach(link => link.classList.remove('active'));
              const activeLink = document.querySelector(`#sidebar-toc .toc-link[data-toc-id="${entry.target.id}"]`);
              activeLink?.classList.add('active');
            }
          });
        }, observerOptions);

        tocLinks.forEach(link => {
          const targetId = link.getAttribute('data-toc-id');
          if (targetId) {
            const target = document.getElementById(targetId);
            if (target) tocObserver.observe(target);
          }
        });
      }

    });
  </script>
</BaseLayout>
