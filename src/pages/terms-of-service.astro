    <Footer />
  </main>
</BaseLayout>

<style>
  details summary {
    transition: all 0.3s ease;
  }

  details[open] summary {
    color: #1B5E3F;
    font-weight: 700;
  }

  details[open] summary span {
    transform: rotate(45deg);
    transition: transform 0.3s ease;
  }
</style>
