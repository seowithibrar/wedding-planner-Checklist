---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

const seo = {
  title: 'Terms of Service — Wedding Planning Checklists',
  description: 'Terms of Service for using WeddingPlanningChecklists.org guides and planning tools.',
  canonical: 'https://www.weddingplanningchecklists.org/terms-of-service'
};
---

<BaseLayout title={seo.title} description={seo.description} canonical={seo.canonical}>
  <Header />

  <main class="py-16 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6 text-slate-700">
    <h1 class="text-4xl font-bold text-[#1A1A1A]">Terms of Service</h1>
    <p class="text-xs text-slate-400">Last updated: August 2026</p>
    <div class="prose max-w-none space-y-4">
      <p>By accessing WeddingPlanningChecklists.org, you agree to comply with our usage guidelines and copyright terms.</p>
    </div>
  </main>

  <Footer />
</BaseLayout>
