---
import HomePage from '../../components/pages/HomePage.astro';
import { NON_DEFAULT_LANGUAGES, type SupportedLanguage } from '../../i18n/config';

export function getStaticPaths() {
  return NON_DEFAULT_LANGUAGES.map(lang => ({
    params: { lang }
  }));
}

const { lang } = Astro.params;
---

<HomePage lang={lang as SupportedLanguage} />
