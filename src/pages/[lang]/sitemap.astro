---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import categorizedChecklists from '../../data/categorized-checklists.json';
import toolRegistry from '../../data/tool-registry.json';
import { NON_DEFAULT_LANGUAGES, type SupportedLanguage } from '../../i18n/config';
import { useTranslations, localizeUrl, SITE_URL } from '../../i18n/utils';

export function getStaticPaths() {
  return NON_DEFAULT_LANGUAGES.map(lang => ({
    params: { lang }
  }));
}

const { lang } = Astro.params;
const currentLang = lang as SupportedLanguage;
const { common, pages } = useTranslations(currentLang);

const canonicalUrl = `${SITE_URL}/${currentLang}/sitemap`;
---

<BaseLayout title={pages.sitemap.title} description={pages.sitemap.description} canonical={canonicalUrl} lang={currentLang}>
  <Header lang={currentLang} />

  <main class="py-16 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    <div class="text-center space-y-4">
      <span class="text-xs font-bold text-[#B76E79] uppercase tracking-wider">Directory</span>
      <h1 class="text-3xl sm:text-5xl font-black text-[#1A1A1A]">{common.footer.sitemap}</h1>
      <p class="text-slate-600 text-sm max-w-xl mx-auto">{pages.sitemap.description}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Tools Section -->
      <div class="bg-white p-6 sm:p-8 rounded-3xl border border-[#F3E8EA] shadow-sm space-y-4">
        <h2 class="text-xl font-bold text-[#1A1A1A] flex items-center gap-2">
          <span>🛠️</span> {common.footer.suiteTitle}
        </h2>
        <ul class="space-y-2 text-sm text-slate-600">
          {toolRegistry.tools.map(tool => (
            <li>
              <a href={localizeUrl(tool.href, currentLang)} class="hover:text-[#B76E79] transition-colors flex items-center justify-between py-1 border-b border-slate-50">
                <span>{tool.title}</span>
                <span class="rtl-flip">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Checklists Section -->
      <div class="bg-white p-6 sm:p-8 rounded-3xl border border-[#F3E8EA] shadow-sm space-y-4">
        <h2 class="text-xl font-bold text-[#1A1A1A] flex items-center gap-2">
          <span>📋</span> {common.footer.timelinesTitle}
        </h2>
        <ul class="space-y-2 text-sm text-slate-600">
          {categorizedChecklists.checklists.map(item => (
            <li>
              <a href={localizeUrl(`/checklists/${item.slug}`, currentLang)} class="hover:text-[#B76E79] transition-colors flex items-center justify-between py-1 border-b border-slate-50">
                <span>{item.title}</span>
                <span class="rtl-flip">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </main>

  <Footer lang={currentLang} />
</BaseLayout>
