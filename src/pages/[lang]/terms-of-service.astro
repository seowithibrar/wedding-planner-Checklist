---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import { NON_DEFAULT_LANGUAGES, type SupportedLanguage } from '../../i18n/config';
import { useTranslations, SITE_URL } from '../../i18n/utils';

export function getStaticPaths() {
  return NON_DEFAULT_LANGUAGES.map(lang => ({
    params: { lang }
  }));
}

const { lang } = Astro.params;
const currentLang = lang as SupportedLanguage;
const { pages, common } = useTranslations(currentLang);

const canonicalUrl = `${SITE_URL}/${currentLang}/terms-of-service`;
---

<BaseLayout title={pages.termsOfService.title} description={pages.termsOfService.description} canonical={canonicalUrl} lang={currentLang}>
  <Header lang={currentLang} />

  <main class="py-16 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6 text-slate-700">
    <h1 class="text-3xl sm:text-4xl font-bold text-[#1A1A1A]">{common.footer.termsOfService}</h1>
    <p class="text-xs text-slate-400">{common.ui.updated}: August 2026</p>
    <div class="prose max-w-none space-y-4 bg-white p-8 rounded-3xl border border-[#F3E8EA] shadow-sm">
      <p>By accessing WeddingPlanningChecklists.org, you agree to comply with our usage guidelines and copyright terms.</p>
    </div>
  </main>

  <Footer lang={currentLang} />
</BaseLayout>
