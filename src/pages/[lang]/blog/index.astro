---
import BlogListPage from '../../../components/pages/BlogListPage.astro';
import { NON_DEFAULT_LANGUAGES, type SupportedLanguage } from '../../../i18n/config';

export function getStaticPaths() {
  return NON_DEFAULT_LANGUAGES.map(lang => ({
    params: { lang }
  }));
}

const { lang } = Astro.params;
---

<BlogListPage lang={lang as SupportedLanguage} />
