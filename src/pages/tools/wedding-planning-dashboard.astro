---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import { PlanningDashboard } from '../../components/tools/PlanningDashboard';
import { generateBreadcrumbSchema, generateWebApplicationSchema } from '../../lib/schema';

const seo = {
  title: 'Wedding Planning Dashboard (2026)',
  description: 'Central hub for your wedding planning suite. At-a-glance countdown, tasks, guest RSVPs, and quick access to all 14 interactive tools.',
  canonical: 'https://www.weddingplanningchecklists.org/tools/wedding-planning-dashboard'
};

const siteUrl = 'https://www.weddingplanningchecklists.org';
const breadcrumbItems = [
  { name: 'Home', item: siteUrl },
  { name: 'Tools', item: `${siteUrl}/tools/budget-calculator` },
  { name: 'Planning Dashboard', item: seo.canonical }
];

const combinedSchema = `[${[
  generateWebApplicationSchema({ name: 'Wedding Planning Dashboard', description: seo.description, url: seo.canonical }),
  generateBreadcrumbSchema(breadcrumbItems)
].filter(Boolean).join(',')}]`;
---

<BaseLayout title={seo.title} description={seo.description} canonical={seo.canonical} schemaScript={combinedSchema}>
  <Header />
  <main class="py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-10">
      <span class="text-xs font-bold text-[#B76E79] uppercase tracking-wider">All-In-One Planning Suite</span>
      <h1 class="text-4xl sm:text-5xl font-black text-[#1A1A1A]">Wedding Planning Dashboard</h1>
      <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
        Your central control center aggregating stats, countdown, RSVPs, and links to all interactive tools.
      </p>
    </div>
    <!-- SEO Intro Copy -->
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pt-4 pb-8 text-center text-slate-600 text-sm leading-relaxed">
      This interactive Wedding Planning Dashboard helps you stay completely organized and on top of your wedding planning process. Simply enter your details below, and the tool will automatically adjust to fit your specific wedding needs. Save time, reduce stress, and ensure no detail is overlooked with this free resource.
    </div>
    <PlanningDashboard client:visible />
  </main>
  <Footer />
</BaseLayout>
