---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import { PlanningTimeline } from '../../components/tools/PlanningTimeline';
import { generateFAQSchema, generateBreadcrumbSchema, generateWebApplicationSchema } from '../../lib/schema';

const seo = {
  title: 'Wedding Planning Timeline (2026)',
  description: 'Map out 31 essential wedding milestones based on your wedding date. Visual interactive timeline with progress tracking and status indicators.',
  canonical: 'https://www.weddingplanningchecklists.org/tools/wedding-planning-timeline'
};

const siteUrl = 'https://www.weddingplanningchecklists.org';
const breadcrumbItems = [
  { name: 'Home', item: siteUrl },
  { name: 'Tools', item: `${siteUrl}/tools/budget-calculator` },
  { name: 'Planning Timeline', item: seo.canonical }
];

const faqs = [
  { q: 'How is the timeline calculated?', a: 'The timeline maps 31 key milestones to specific months before your wedding date, calculating exact target dates automatically.' },
  { q: 'Can I mark milestones as complete?', a: 'Yes, click any milestone dot to cycle between Not Started, In Progress, and Completed.' }
];

const combinedSchema = `[${[
  generateWebApplicationSchema({ name: 'Wedding Planning Timeline', description: seo.description, url: seo.canonical }),
  generateFAQSchema(faqs),
  generateBreadcrumbSchema(breadcrumbItems)
].filter(Boolean).join(',')}]`;
---

<BaseLayout title={seo.title} description={seo.description} canonical={seo.canonical} schemaScript={combinedSchema}>
  <Header />
  <main class="py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-10">
      <span class="text-xs font-bold text-[#B76E79] uppercase tracking-wider">Free Planning Tool</span>
      <h1 class="text-4xl sm:text-5xl font-black text-[#1A1A1A]">Wedding Planning Timeline</h1>
      <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
        Visual milestone timeline mapping 31 key planning steps to your wedding date schedule.
      </p>
    </div>
    <!-- SEO Intro Copy -->
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pt-4 pb-8 text-center text-slate-600 text-sm leading-relaxed">
      This interactive Wedding Planning Timeline helps you stay completely organized and on top of your wedding planning process. Simply enter your details below, and the tool will automatically adjust to fit your specific wedding needs. Save time, reduce stress, and ensure no detail is overlooked with this free resource.
    </div>
    <PlanningTimeline client:visible />
  </main>
  <Footer />
</BaseLayout>
