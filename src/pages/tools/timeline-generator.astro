---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import { TimelineGenerator } from '../../components/tools/TimelineGenerator';

const seo = {
  title: 'Timeline Generator (2026)',
  description: 'Generate a customized day-of wedding timeline based on your ceremony start time. Includes hair, makeup, photos, cocktail hour, and dinner schedules.',
  canonical: 'https://www.weddingplanningchecklists.org/tools/timeline-generator'
};
---

<BaseLayout title={seo.title} description={seo.description} canonical={seo.canonical}>
  <Header />

  <main class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-12">
      <span class="text-xs font-bold text-[#B76E79] uppercase tracking-wider">Free Planning Tool</span>
      <h1 class="text-4xl sm:text-5xl font-black text-[#1A1A1A]">Wedding Timeline Generator</h1>
      <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
        Select your ceremony start time to generate a complete schedule for getting ready, first look photos, reception entrance, and dinner.
      </p>
    </div>

    <!-- React Island loaded client-side -->
    <!-- SEO Intro Copy -->
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pt-4 pb-8 text-center text-slate-600 text-sm leading-relaxed">
      This interactive Timeline Generator helps you stay completely organized and on top of your wedding planning process. Simply enter your details below, and the tool will automatically adjust to fit your specific wedding needs. Save time, reduce stress, and ensure no detail is overlooked with this free resource.
    </div>
    <TimelineGenerator client:visible />
  </main>

  <Footer />
</BaseLayout>
