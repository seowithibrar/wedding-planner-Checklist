---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import { TaskGenerator } from '../../components/tools/TaskGenerator';
import { generateFAQSchema, generateBreadcrumbSchema, generateWebApplicationSchema } from '../../lib/schema';

const seo = {
  title: 'Smart Wedding Task Generator & Priority Planner',
  description: 'Generate a personalized wedding task list based on your wedding style, budget, guest count, and timeline priorities.',
  canonical: 'https://www.weddingplanningchecklists.org/tools/wedding-task-generator'
};

const siteUrl = 'https://www.weddingplanningchecklists.org';
const breadcrumbItems = [
  { name: 'Home', item: siteUrl },
  { name: 'Tools', item: `${siteUrl}/tools/budget-calculator` },
  { name: 'Task Generator', item: seo.canonical }
];

const combinedSchema = `[${[
  generateWebApplicationSchema({ name: 'Wedding Task Generator', description: seo.description, url: seo.canonical }),
  generateBreadcrumbSchema(breadcrumbItems)
].filter(Boolean).join(',')}]`;
---

<BaseLayout title={seo.title} description={seo.description} canonical={seo.canonical} schemaScript={combinedSchema}>
  <Header />
  <main class="py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-10">
      <span class="text-xs font-bold text-[#B76E79] uppercase tracking-wider">Free Planning Tool</span>
      <h1 class="text-4xl sm:text-5xl font-black text-[#1A1A1A]">Smart Wedding Task Generator</h1>
      <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
        Custom task list generated specifically for your wedding style, budget, and guest count.
      </p>
    </div>
    <TaskGenerator client:visible />
  </main>
  <Footer />
</BaseLayout>
