---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import { DailyPlanner } from '../../components/tools/DailyPlanner';
import { generateBreadcrumbSchema, generateWebApplicationSchema } from '../../lib/schema';

const seo = {
  title: 'Free Daily Wedding Planner & Time-Blocked Schedule',
  description: 'Organize your wedding planning day-by-day with morning, afternoon, and evening time blocks and daily notes.',
  canonical: 'https://www.weddingplanningchecklists.org/tools/daily-wedding-planner'
};

const siteUrl = 'https://www.weddingplanningchecklists.org';
const breadcrumbItems = [
  { name: 'Home', item: siteUrl },
  { name: 'Tools', item: `${siteUrl}/tools/budget-calculator` },
  { name: 'Daily Planner', item: seo.canonical }
];

const combinedSchema = `[${[
  generateWebApplicationSchema({ name: 'Daily Wedding Planner', description: seo.description, url: seo.canonical }),
  generateBreadcrumbSchema(breadcrumbItems)
].filter(Boolean).join(',')}]`;
---

<BaseLayout title={seo.title} description={seo.description} canonical={seo.canonical} schemaScript={combinedSchema}>
  <Header />
  <main class="py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-10">
      <span class="text-xs font-bold text-[#B76E79] uppercase tracking-wider">Free Planning Tool</span>
      <h1 class="text-4xl sm:text-5xl font-black text-[#1A1A1A]">Daily Wedding Planner</h1>
      <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
        Time-blocked day planner for morning, afternoon, and evening tasks.
      </p>
    </div>
    <DailyPlanner client:visible />
  </main>
  <Footer />
</BaseLayout>
