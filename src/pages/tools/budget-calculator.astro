---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import { BudgetCalculator } from '../../components/tools/BudgetCalculator';

const seo = {
  title: 'Free Wedding Budget Calculator & Expense Allocator',
  description: 'Estimate your wedding expenses with our free interactive budget calculator. Break down venue, catering, photo, floral, and buffer costs instantly.',
  canonical: 'https://www.weddingplanningchecklists.org/tools/budget-calculator'
};
---

<BaseLayout title={seo.title} description={seo.description} canonical={seo.canonical}>
  <Header />

  <main class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-12">
      <span class="text-xs font-bold text-[#B76E79] uppercase tracking-wider">Free Planning Tool</span>
      <h1 class="text-4xl sm:text-5xl font-black text-[#1A1A1A]">Wedding Budget Calculator</h1>
      <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
        Calculate your target spending allocations across catering, photography, flowers, attire, and emergency contingency reserves.
      </p>
    </div>

    <!-- React Island loaded client-side when visible -->
    <BudgetCalculator client:visible />
  </main>

  <Footer />
</BaseLayout>
