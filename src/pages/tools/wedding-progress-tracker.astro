---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import { ProgressTracker } from '../../components/tools/ProgressTracker';
import { generateBreadcrumbSchema, generateWebApplicationSchema } from '../../lib/schema';

const seo = {
  title: 'Wedding Progress Tracker (2026)',
  description: 'Monitor overall wedding planning completion across all 15 categories with animated progress rings and task stats.',
  canonical: 'https://www.weddingplanningchecklists.org/tools/wedding-progress-tracker'
};

const siteUrl = 'https://www.weddingplanningchecklists.org';
const breadcrumbItems = [
  { name: 'Home', item: siteUrl },
  { name: 'Tools', item: `${siteUrl}/tools/budget-calculator` },
  { name: 'Progress Tracker', item: seo.canonical }
];

const combinedSchema = `[${[
  generateWebApplicationSchema({ name: 'Wedding Progress Tracker', description: seo.description, url: seo.canonical }),
  generateBreadcrumbSchema(breadcrumbItems)
].filter(Boolean).join(',')}]`;
---

<BaseLayout title={seo.title} description={seo.description} canonical={seo.canonical} schemaScript={combinedSchema}>
  <Header />
  <main class="py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-10">
      <span class="text-xs font-bold text-[#B76E79] uppercase tracking-wider">Free Planning Tool</span>
      <h1 class="text-4xl sm:text-5xl font-black text-[#1A1A1A]">Wedding Progress Tracker</h1>
      <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
        Track overall planning completion percentage across all 15 task categories.
      </p>
    </div>
    <!-- SEO Intro Copy -->
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pt-4 pb-8 text-center text-slate-600 text-sm leading-relaxed">
      This interactive Wedding Progress Tracker helps you stay completely organized and on top of your wedding planning process. Simply enter your details below, and the tool will automatically adjust to fit your specific wedding needs. Save time, reduce stress, and ensure no detail is overlooked with this free resource.
    </div>
    <ProgressTracker client:visible />
  </main>
  <Footer />
</BaseLayout>
