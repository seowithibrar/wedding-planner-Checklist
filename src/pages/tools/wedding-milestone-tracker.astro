---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import { MilestoneTracker } from '../../components/tools/MilestoneTracker';
import { generateBreadcrumbSchema, generateWebApplicationSchema } from '../../lib/schema';

const seo = {
  title: 'Interactive Wedding Milestone Tracker & Kanban Board',
  description: 'Track 31 key wedding planning milestones with interactive Kanban board and timeline views. Monitor completion status in real-time.',
  canonical: 'https://www.weddingplanningchecklists.org/tools/wedding-milestone-tracker'
};

const siteUrl = 'https://www.weddingplanningchecklists.org';
const breadcrumbItems = [
  { name: 'Home', item: siteUrl },
  { name: 'Tools', item: `${siteUrl}/tools/budget-calculator` },
  { name: 'Milestone Tracker', item: seo.canonical }
];

const combinedSchema = `[${[
  generateWebApplicationSchema({ name: 'Wedding Milestone Tracker', description: seo.description, url: seo.canonical }),
  generateBreadcrumbSchema(breadcrumbItems)
].filter(Boolean).join(',')}]`;
---

<BaseLayout title={seo.title} description={seo.description} canonical={seo.canonical} schemaScript={combinedSchema}>
  <Header />
  <main class="py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-10">
      <span class="text-xs font-bold text-[#B76E79] uppercase tracking-wider">Free Planning Tool</span>
      <h1 class="text-4xl sm:text-5xl font-black text-[#1A1A1A]">Wedding Milestone Tracker</h1>
      <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
        Track key planning milestones using an interactive Kanban board or timeline view.
      </p>
    </div>
    <MilestoneTracker client:visible />
  </main>
  <Footer />
</BaseLayout>
