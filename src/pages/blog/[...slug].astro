---
import BlogArticlePage from '../../components/pages/BlogArticlePage.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => {
    const slug = post.data.slug || post.id.replace(/\.(md|mdx)$/, '');
    return {
      params: { slug },
      props: { 
        post,
        slug,
        allPosts: posts.filter(p => (p.data.slug || p.id.replace(/\.(md|mdx)$/, '')) !== slug).slice(0, 3)
      },
    };
  });
}

const { post, slug, allPosts } = Astro.props;
---

<BlogArticlePage post={post} slug={slug} allPosts={allPosts} lang="en" />
