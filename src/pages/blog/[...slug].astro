---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import { getCollection, render } from 'astro:content';
import { generateArticleSchema, generateFAQSchema, generateBreadcrumbSchema } from '../../lib/schema';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { 
      post,
      allPosts: posts.filter(p => p.id !== post.id).slice(0, 3)
    },
  }));
}

const { post, allPosts } = Astro.props;
const { Content } = await render(post);

const canonicalUrl = `https://www.weddingplanningchecklists.org/blog/${post.id}`;
const articleSchema = generateArticleSchema({
  title: post.data.title,
  description: post.data.description,
  url: canonicalUrl,
  image: post.data.heroImage
});

const faqSchema = post.data.faqs ? generateFAQSchema(post.data.faqs) : null;
const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Home', item: 'https://www.weddingplanningchecklists.org/' },
  { name: 'Blog', item: 'https://www.weddingplanningchecklists.org/blog' },
  { name: post.data.title, item: canonicalUrl }
]);

const combinedSchema = `[${articleSchema}${faqSchema ? `, ${faqSchema}` : ''}, ${breadcrumbSchema}]`;
---

<BaseLayout 
  title={post.data.title} 
  description={post.data.description} 
  canonical={canonicalUrl}
  image={post.data.heroImage}
  type="article"
  schemaScript={combinedSchema}
>
  <Header />

  <!-- Hero Header Section -->
  <header class="pt-10 pb-12 bg-gradient-to-b from-[#FCECF0]/50 via-white to-transparent border-b border-[#F3E8EA]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
      
      <!-- 1. Breadcrumb Navigation -->
      <nav class="flex items-center justify-center gap-2 text-xs font-semibold text-slate-500" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[#B76E79] transition-colors">Home</a>
        <span class="text-slate-300">/</span>
        <a href="/blog" class="hover:text-[#B76E79] transition-colors">Blog</a>
        <span class="text-slate-300">/</span>
        <span class="text-[#B76E79] truncate max-w-xs">{post.data.title}</span>
      </nav>

      <!-- 2. Category Badge & Meta -->
      <div class="flex items-center justify-center gap-3 text-xs font-bold">
        <span class="bg-[#B76E79] text-white px-3.5 py-1 rounded-full uppercase tracking-wider shadow-sm">
          {post.data.category}
        </span>
        <span class="text-slate-400">•</span>
        <span class="text-slate-600">{post.data.readTime} read</span>
      </div>

      <!-- 3. H1 Title -->
      <h1 class="text-3xl sm:text-5xl font-black text-[#1A1A1A] leading-tight tracking-tight max-w-3xl mx-auto">
        {post.data.title}
      </h1>

      <div class="flex items-center justify-center gap-4 text-xs text-slate-500 font-medium">
        <span>By <strong class="text-[#1A1A1A]">{post.data.author}</strong></span>
        <span>•</span>
        <span>Updated August 2026</span>
      </div>
    </div>
  </header>

  <!-- Article Hero Image -->
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 -mt-6 mb-12">
    <div class="rounded-3xl overflow-hidden shadow-xl border border-white/60 bg-white">
      <img 
        src={post.data.heroImage} 
        alt={post.data.heroImageAlt || post.data.title} 
        class="w-full h-auto max-h-[520px] object-cover hover:scale-[1.01] transition-transform duration-700" 
      />
    </div>
  </div>

  <!-- Main 2-Column Content Grid -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-24 grid grid-cols-1 lg:grid-cols-12 gap-12">
    
    <!-- Sticky Table of Contents Sidebar -->
    <aside class="col-span-1 lg:col-span-3 hidden lg:block">
      <div class="sticky top-28 space-y-6">
        <div class="bg-white p-6 rounded-3xl border border-[#F3E8EA] shadow-sm">
          <h3 class="font-bold text-sm text-[#1A1A1A] uppercase tracking-wider mb-4 pb-2 border-b border-slate-100 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[#B76E79]"></span> Table of Contents
          </h3>
          <nav class="space-y-2 text-xs font-semibold text-slate-600">
            <a href="#quick-summary" class="block hover:text-[#B76E79] transition-colors py-1 pl-2 border-l-2 border-transparent hover:border-[#B76E79]">Quick Summary</a>
            <a href="#main-content" class="block hover:text-[#B76E79] transition-colors py-1 pl-2 border-l-2 border-transparent hover:border-[#B76E79]">Main Guide</a>
            {post.data.faqs && post.data.faqs.length > 0 && (
              <a href="#faq" class="block hover:text-[#B76E79] transition-colors py-1 pl-2 border-l-2 border-transparent hover:border-[#B76E79]">Frequently Asked Questions</a>
            )}
            <a href="#author" class="block hover:text-[#B76E79] transition-colors py-1 pl-2 border-l-2 border-transparent hover:border-[#B76E79]">About Author</a>
          </nav>
        </div>

        <!-- Download Printable Banner Card -->
        <div className="bg-gradient-to-br from-[#1A1A1A] to-slate-900 text-white p-6 rounded-3xl text-center space-y-4 shadow-lg">
          <span class="text-[10px] font-bold uppercase tracking-widest text-[#B76E79] block">Free Download</span>
          <h4 class="font-bold text-sm leading-snug">Printable Wedding Checklist Suite</h4>
          <p class="text-xs text-slate-300">Get instant access to complete month-by-month planning sheets and budget templates.</p>
          <a href="/blog/the-ultimate-wedding-planning-checklists-guide-for-a-stress-free-wedding" class="block w-full bg-[#B76E79] hover:bg-rose-600 text-white py-2.5 rounded-2xl text-xs font-bold transition-all shadow-md">
            Download Free Printable
          </a>
        </div>
      </div>
    </aside>

    <!-- Main Content Column -->
    <article class="col-span-1 lg:col-span-9 space-y-10">
      
      <!-- Key Takeaways Box -->
      {post.data.keyTakeaways && post.data.keyTakeaways.length > 0 && (
        <section id="quick-summary" class="bg-[#FCECF0]/70 border-l-4 border-[#B76E79] p-6 sm:p-8 rounded-r-3xl shadow-sm space-y-3">
          <h3 class="font-bold text-sm text-[#1A1A1A] uppercase tracking-wider flex items-center gap-2">
            <span class="text-[#D4AF37] text-lg">⚡</span> Key Takeaways
          </h3>
          <ul class="space-y-2 text-xs sm:text-sm text-slate-800 font-medium">
            {post.data.keyTakeaways.map(item => (
              <li class="flex items-start gap-2.5">
                <span class="text-[#B76E79] font-bold">•</span>
                <span class="leading-relaxed">{item}</span>
              </li>
            ))}
          </ul>
        </section>
      )}

      <!-- Main MDX Article Content -->
      <div id="main-content" class="article-content prose prose-lg prose-rose max-w-none">
        <Content />
      </div>

      <!-- FAQ Section -->
      {post.data.faqs && post.data.faqs.length > 0 && (
        <section id="faq" class="pt-10 border-t border-[#F3E8EA] space-y-6">
          <h2 class="text-2xl sm:text-3xl font-bold text-[#1A1A1A]">Frequently Asked Questions</h2>
          <div class="space-y-4">
            {post.data.faqs.map(faq => (
              <div class="bg-white border border-[#F3E8EA] p-6 rounded-3xl shadow-sm hover:shadow-md transition-all">
                <h3 class="font-bold text-base text-[#1A1A1A] mb-2 flex items-center gap-2">
                  <span class="text-[#B76E79] font-bold">Q.</span> {faq.q}
                </h3>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed pl-6">{faq.a}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Author Box -->
      <section id="author" class="bg-white border border-[#F3E8EA] p-6 sm:p-8 rounded-3xl shadow-sm flex flex-col sm:flex-row items-center sm:items-start gap-6">
        <div class="w-20 h-20 rounded-full overflow-hidden shrink-0 border-2 border-[#B76E79] shadow-sm">
          <img src="https://ui-avatars.com/api/?name=Wedding+Planning+Checklists&background=fcecf0&color=B76E79&size=200" alt={post.data.author} class="w-full h-full object-cover" />
        </div>
        <div class="space-y-2 text-center sm:text-left">
          <h3 class="font-bold text-lg text-[#1A1A1A]">{post.data.author}</h3>
          <span class="text-xs font-semibold text-[#B76E79] uppercase tracking-wider block">Certified Wedding Planning Experts</span>
          <p class="text-xs text-slate-600 leading-relaxed">
            The Wedding Planning Checklists Team is dedicated to helping engaged couples plan their dream wedding without stress. We deliver expert timeline templates, budget trackers, and cultural planning advice.
          </p>
        </div>
      </section>

      <!-- Related Articles Section -->
      {allPosts && allPosts.length > 0 && (
        <section class="pt-10 border-t border-[#F3E8EA] space-y-6">
          <h2 class="text-2xl font-bold text-[#1A1A1A]">Related Planning Articles</h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {allPosts.map(rel => (
              <a href={`/blog/${rel.id}`} class="block bg-white rounded-3xl overflow-hidden border border-[#F3E8EA] shadow-sm hover:shadow-md transition-all group flex flex-col justify-between">
                <div class="h-40 overflow-hidden bg-slate-100">
                  <img src={rel.data.heroImage} alt={rel.data.heroImageAlt || rel.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                </div>
                <div class="p-5 flex-grow flex flex-col justify-between space-y-3">
                  <div>
                    <span class="text-[10px] font-bold text-[#B76E79] uppercase tracking-wider">{rel.data.category}</span>
                    <h3 class="font-bold text-sm text-[#1A1A1A] group-hover:text-[#B76E79] transition-colors mt-1 line-clamp-2">{rel.data.title}</h3>
                  </div>
                  <span class="text-xs font-bold text-[#B76E79]">Read Guide →</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- Newsletter CTA Banner -->
      <section class="bg-gradient-to-r from-[#1A1A1A] via-slate-900 to-[#1A1A1A] text-white p-8 sm:p-12 rounded-3xl text-center space-y-4 shadow-xl">
        <h3 class="text-2xl font-bold text-[#FCECF0]">Join Thousands of Happy Couples</h3>
        <p class="text-xs sm:text-sm text-slate-300 max-w-xl mx-auto">Get monthly wedding checklist reminders, budget savings tips, and exclusive printable templates straight to your inbox.</p>
        <div class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto pt-2">
          <input type="email" placeholder="Enter your email address" class="flex-grow px-5 py-3 rounded-2xl bg-white text-slate-900 text-xs outline-none focus:ring-2 focus:ring-[#B76E79]" />
          <button class="bg-[#B76E79] hover:bg-rose-600 text-white px-6 py-3 rounded-2xl text-xs font-bold transition-all shadow-md whitespace-nowrap">
            Subscribe Free
          </button>
        </div>
      </section>

    </article>
  </div>

  <Footer />
</BaseLayout>
