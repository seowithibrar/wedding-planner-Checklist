---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import toolRegistry from '../data/tool-registry.json';

const seo = {
  title: 'Free Interactive Wedding Planning Tools & Checklists (2026)',
  description: '14+ free interactive wedding planning tools: Guest List Manager, Budget Calculator, Checklist Generator, Milestone Tracker, Countdown, Planning Calendar, and Planners.',
  canonical: 'https://www.weddingplanningchecklists.org/'
};
---

<BaseLayout title={seo.title} description={seo.description} canonical={seo.canonical}>
  <Header />

  <main>
    <!-- Hero Section -->
    <section class="relative py-20 lg:py-28 overflow-hidden bg-gradient-to-b from-[#FCECF0]/40 to-transparent">
      <div class="max-w-5xl mx-auto px-4 text-center space-y-6">
        <span class="inline-block bg-[#FCECF0] text-[#B76E79] px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider">
          Complete Wedding Planning Suite
        </span>
        <h1 class="text-4xl sm:text-6xl font-extrabold text-[#1A1A1A] leading-tight tracking-tight">
          Plan Your Dream Wedding with <span class="text-[#B76E79]">Zero Stress</span>
        </h1>
        <p class="text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed">
          14+ free interactive tools, budget calculators, guest list managers, and month-by-month timelines tailored for brides and couples worldwide.
        </p>
        <div class="flex flex-wrap justify-center gap-4 pt-4">
          <a href="/tools/wedding-planning-dashboard" class="bg-[#B76E79] hover:bg-[#a25d66] text-white px-8 py-4 rounded-full text-sm font-bold shadow-lg transition-all">
            Open Planning Dashboard
          </a>
          <a href="/tools/guest-list-manager" class="bg-white hover:bg-slate-50 text-[#1A1A1A] border border-slate-200 px-8 py-4 rounded-full text-sm font-bold transition-all shadow-sm">
            Guest List Manager
          </a>
        </div>
      </div>
    </section>

    <!-- Free Interactive Tools Grid -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="text-center space-y-3 mb-12">
        <span class="text-xs font-bold text-[#B76E79] uppercase tracking-wider">Interactive Suite</span>
        <h2 class="text-3xl sm:text-4xl font-black text-[#1A1A1A]">14 Free Wedding Planning Tools</h2>
        <p class="text-slate-600 max-w-xl mx-auto text-sm sm:text-base">
          All tools sync automatically with your wedding date and save your progress safely in your browser.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
        {toolRegistry.tools.map(tool => (
          <a
            href={tool.href}
            class="bg-white rounded-3xl p-6 border border-[#F3E8EA] shadow-sm hover:shadow-md hover:border-[#B76E79]/40 transition-all group flex flex-col justify-between"
          >
            <div class="space-y-3">
              <span class="inline-block text-[10px] font-bold uppercase tracking-wider text-[#B76E79] bg-[#FCECF0] px-2.5 py-1 rounded-full">
                {tool.category}
              </span>
              <h3 class="font-bold text-lg text-[#1A1A1A] group-hover:text-[#B76E79] transition-colors">{tool.title}</h3>
              <p class="text-xs text-slate-500 leading-relaxed">{tool.description}</p>
            </div>
            <div class="pt-4 flex items-center gap-1 text-xs font-bold text-[#B76E79]">
              <span>Use Tool</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Featured Guides Grid -->
    <section class="max-w-7xl mx-auto px-4 py-16 bg-slate-50/50 border-t border-slate-100">
      <h2 class="text-3xl font-bold text-center text-[#1A1A1A] mb-12">Popular Planning Guides</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <a href="/blog/18-month-wedding-planning-timeline" class="bg-white rounded-3xl p-6 border border-[#F3E8EA] shadow-sm hover:shadow-md transition-all group">
          <span class="text-xs font-bold text-[#B76E79] uppercase">Planning</span>
          <h3 class="font-bold text-xl text-[#1A1A1A] group-hover:text-[#B76E79] transition-colors mt-2 mb-3">Complete 18-Month Timeline</h3>
          <p class="text-xs text-slate-500 leading-relaxed">Month-by-month guide with deposit timelines and cultural event integrations.</p>
        </a>
        <a href="/blog/hairstyles-for-wedding" class="bg-white rounded-3xl p-6 border border-[#F3E8EA] shadow-sm hover:shadow-md transition-all group">
          <span class="text-xs font-bold text-[#B76E79] uppercase">Style Guide</span>
          <h3 class="font-bold text-xl text-[#1A1A1A] group-hover:text-[#B76E79] transition-colors mt-2 mb-3">50+ Bridal Hairstyles</h3>
          <p class="text-xs text-slate-500 leading-relaxed">Bridal buns, Hollywood waves, and South Asian wedding hairstyle guides.</p>
        </a>
        <a href="/blog/how-to-choose-wedding-venue" class="bg-white rounded-3xl p-6 border border-[#F3E8EA] shadow-sm hover:shadow-md transition-all group">
          <span class="text-xs font-bold text-[#B76E79] uppercase">Venues</span>
          <h3 class="font-bold text-xl text-[#1A1A1A] group-hover:text-[#B76E79] transition-colors mt-2 mb-3">How to Choose a Venue</h3>
          <p class="text-xs text-slate-500 leading-relaxed">Site tour questions, hidden vendor fees, and Plan B rain contingency tips.</p>
        </a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
