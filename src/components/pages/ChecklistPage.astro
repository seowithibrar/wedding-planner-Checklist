---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../layout/Header.astro';
import Footer from '../layout/Footer.astro';
import SixMonthWeddingPlanningChecklist from '../mdx/SixMonthWeddingPlanningChecklist.mdx';
import ThreeMonthWeddingPlanningChecklist from '../mdx/ThreeMonthWeddingPlanningChecklist.mdx';
import checklistsData from '../../data/categorized-checklists.json';
import { generateBreadcrumbSchema, generateFAQSchema, generateArticleSchema, generateHowToSchema } from '../../lib/schema';
import { useTranslations, localizeUrl, SITE_URL } from '../../i18n/utils';
import { DEFAULT_LANGUAGE, type SupportedLanguage } from '../../i18n/config';

export interface Props {
  checklist: any;
  lang?: string;
}

const { checklist, lang = DEFAULT_LANGUAGE } = Astro.props;
const currentLang = lang as SupportedLanguage;
const isEnglishThreeMonthChecklist = currentLang === DEFAULT_LANGUAGE && checklist.slug === '3-month-wedding-planning-checklist';
const isPrintableWeddingChecklist = checklist.slug === 'printable-wedding-planning-checklist';
const displayHeroImage = isPrintableWeddingChecklist
  ? '/images/checklists/printable-wedding-planning-checklist/printable-wedding-planning-checklist-hero.webp'
  : checklist.heroImage;
const displayHeroAlt = isPrintableWeddingChecklist
  ? 'Printable wedding planning checklist binder with wedding stationery'
  : checklist.heroImageAlt || checklist.title;
const displayDescription = isPrintableWeddingChecklist
  ? 'Download a free four-page printable wedding planning checklist PDF with a 12-month task timeline, checkboxes, vendor contacts, payment tracking, and notes space. Print it for your wedding binder or use it as a simple paper planning system from engagement to wedding day.'
  : checklist.description;
const { common, checklists } = useTranslations(currentLang);

const canonicalUrl = currentLang === DEFAULT_LANGUAGE 
  ? `${SITE_URL}/checklists/${checklist.slug}` 
  : `${SITE_URL}/${currentLang}/checklists/${checklist.slug}`;

const seo = {
  title: checklist.seoTitle || `${checklist.title} (2026)`,
  description: checklist.metaDescription || checklist.description,
  canonical: canonicalUrl
};

const breadcrumbItems = [
  { name: common.nav.home, item: localizeUrl('/', currentLang) },
  { name: 'Checklists', item: localizeUrl('/#categorized-checklists', currentLang) },
  { name: checklist.title, item: seo.canonical }
];

const faqs: { q: string; a: string }[] = checklist.faqs || [
  {
    q: `How do I use the ${checklist.title}?`,
    a: `Start by reviewing the key takeaways and timeline stages outlined in this guide. Combine it with our free interactive tools to track your RSVPs, budget, and daily to-do lists.`
  },
  {
    q: `Is the ${checklist.title} completely free?`,
    a: `Yes! All checklist templates and interactive planning tools on WeddingPlanningChecklists.org are 100% free to access, download, and print.`
  },
  {
    q: `Can I customize this checklist for my wedding style?`,
    a: `Absolutely. You can tailor every task by using our interactive Wedding Task Generator and Dashboard to add or remove custom items.`
  }
];

const imageUrl = new URL(displayHeroImage || '/Wedding%20Planning%20Checklist.webp', SITE_URL).toString();
const schemas = [
  generateArticleSchema({
    title: checklist.title,
    description: seo.description,
    url: canonicalUrl,
    image: imageUrl,
    authorName: checklist.author || 'Wedding Planning Checklists Team',
    dateModified: checklist.dateModified,
    datePublished: checklist.datePublished
  }),
  generateFAQSchema(faqs),
  generateBreadcrumbSchema(breadcrumbItems),
  checklist.howTo
    ? generateHowToSchema({ ...checklist.howTo, url: canonicalUrl })
    : null
].filter(Boolean);
const schemaGraph = schemas.map(schema => {
  const schemaData = JSON.parse(schema as string);
  if (schemaData['@type'] === 'Article') {
    schemaData['@id'] = `${canonicalUrl}#article`;
  }
  delete schemaData['@context'];
  return schemaData;
});
const combinedSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': schemaGraph
});
---

<BaseLayout title={seo.title} description={seo.description} ogTitle={seo.title} ogDescription={seo.description} titleIsFinal={Boolean(checklist.seoTitle)} canonical={seo.canonical} modifiedDate={checklist.dateModified} schemaScript={combinedSchema} lang={currentLang}>
  <Header lang={currentLang} />

  <main class="space-y-12">
    <!-- Breadcrumbs -->
    <nav class="max-w-[1300px] mx-auto px-4 pt-6 text-xs text-slate-500 flex items-center gap-2">
      <a href={localizeUrl('/', currentLang)} class="hover:text-[#B76E79]">{common.nav.home}</a>
      <span>/</span>
      <a href={localizeUrl('/#categorized-checklists', currentLang)} class="hover:text-[#B76E79]">Checklists</a>
      <span>/</span>
      <span class="text-slate-800 font-semibold">{checklist.title}</span>
    </nav>

    <!-- Page Header Hero -->
    <header class="max-w-[1300px] mx-auto px-4 space-y-4">
      <div class="inline-flex items-center gap-2 bg-[#FCECF0] text-[#B76E79] px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider">
        <span>{checklist.icon}</span>
        <span>{checklist.category} Guide</span>
        <span>•</span>
        <span>{checklist.badge}</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-[#1A1A1A] leading-tight">
        {checklist.title}
      </h1>
      {!checklist.longForm && !isEnglishThreeMonthChecklist && (
        <p class="text-base sm:text-lg text-slate-600 max-w-3xl leading-relaxed">
          {displayDescription}
        </p>
      )}

      {currentLang !== DEFAULT_LANGUAGE && (
        <div class="inline-flex items-center gap-2 bg-white border border-[#F3E8EA] px-4 py-1.5 rounded-full text-xs text-slate-600 shadow-sm">
          <span>🌐</span>
          <span>{common.ui.translationNotice}</span>
        </div>
      )}
      
      <!-- Authorship & Date Meta -->
      <div class="flex items-center gap-4 text-xs font-medium text-slate-500 pt-2">
        <span class="inline-flex items-center gap-2">
          <div class="w-6 h-6 rounded-full bg-[#B76E79] text-white flex items-center justify-center font-bold text-[9px]">{checklist.author === 'Wedding Planning Checklists Team' ? 'W' : 'SJ'}</div>
          {common.ui.by} <strong class="text-[#1A1A1A]">{checklist.author || 'Sarah Jenkins'}</strong>
        </span>
        <span class="text-slate-300">|</span>
        <span>{common.ui.updated}: {checklist.updatedDate || 'September 6, 2026'}</span>
      </div>
    </header>

    {displayHeroImage && (
      <div class="max-w-[1300px] mx-auto px-4">
        <img
          src={displayHeroImage}
          alt={displayHeroAlt}
          class="w-full aspect-video object-cover rounded-2xl border border-[#F3E8EA] shadow-sm"
          width="1376"
          height="768"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    )}

    <!-- Main Content Grid -->
    <section class="max-w-[1300px] mx-auto px-4 grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- Main Content Column -->
      <article class="lg:col-span-2 bg-white rounded-3xl border border-[#F3E8EA] p-6 sm:p-10 shadow-sm space-y-8">

        {checklist.longForm ? (
          <div class="six-month-checklist article-content prose prose-lg prose-rose max-w-none">
            <SixMonthWeddingPlanningChecklist />
          </div>
        ) : isEnglishThreeMonthChecklist ? (
          <>
            <div class="bg-[#FCECF0]/30 border border-[#B76E79]/20 p-6 rounded-2xl space-y-2">
              <h2 class="text-lg font-bold text-[#B76E79]">Summary</h2>
              <p class="text-sm text-slate-700 leading-relaxed">{checklist.summary}</p>
            </div>

            <nav aria-label="Table of contents" class="rounded-2xl border border-[#F3E8EA] bg-slate-50 p-5">
              <h2 class="mb-3 text-base font-bold text-[#1A1A1A]">On this page</h2>
              <ul class="grid grid-cols-1 gap-2 text-sm sm:grid-cols-2">
                <li><a class="text-[#B76E79] hover:underline" href="#can-you-plan-a-wedding-in-3-months">Can You Plan a Wedding in 3 Months?</a></li>
                <li><a class="text-[#B76E79] hover:underline" href="#how-to-use-this-3-month-wedding-planning-checklist">How to Use This 3 Month Wedding Planning Checklist</a></li>
                <li><a class="text-[#B76E79] hover:underline" href="#the-first-72-hours-decisions-that-unlock-everything-else">The First 72 Hours: Decisions That Unlock Everything Else</a></li>
                <li><a class="text-[#B76E79] hover:underline" href="#the-3-month-wedding-planning-checklist-at-a-glance">The 3 Month Wedding Planning Checklist at a Glance</a></li>
                <li><a class="text-[#B76E79] hover:underline" href="#weeks-12-to-10-book-the-essentials-first">Weeks 12 to 10: Book the Essentials First</a></li>
                <li><a class="text-[#B76E79] hover:underline" href="#weeks-9-to-7-style-guests-and-look">Weeks 9 to 7: Style, Guests, and Look</a></li>
                <li><a class="text-[#B76E79] hover:underline" href="#weeks-6-to-4-paperwork-details-and-logistics">Weeks 6 to 4: Paperwork, Details, and Logistics</a></li>
                <li><a class="text-[#B76E79] hover:underline" href="#weeks-3-to-2-confirm-everything">Weeks 3 to 2: Confirm Everything</a></li>
                <li><a class="text-[#B76E79] hover:underline" href="#the-final-week-rehearse-pack-and-rest">The Final Week: Rehearse, Pack, and Rest</a></li>
                <li><a class="text-[#B76E79] hover:underline" href="#what-to-book-first-simplify-or-skip">What to Book First, Simplify, or Skip</a></li>
                <li><a class="text-[#B76E79] hover:underline" href="#90-day-wedding-planning-checklist-for-a-small-budget">90 Day Wedding Planning Checklist for a Small Budget</a></li>
                <li><a class="text-[#B76E79] hover:underline" href="#planning-a-wedding-in-2-months-or-6-months">Planning a Wedding in 2 Months or 6 Months?</a></li>
                <li><a class="text-[#B76E79] hover:underline" href="#3-month-wedding-planning-checklist-pdf-and-printable-version">3 Month Wedding Planning Checklist PDF and Printable Version</a></li>
                <li><a class="text-[#B76E79] hover:underline" href="#planning-a-multi-day-south-asian-wedding-in-3-months">Planning a Multi-Day South Asian Wedding in 3 Months</a></li>
                <li><a class="text-[#B76E79] hover:underline" href="#mistakes-to-avoid-with-your-3-month-wedding-planning-checklist">Mistakes to Avoid With Your 3 Month Wedding Planning Checklist</a></li>
                <li><a class="text-[#B76E79] hover:underline" href="#frequently-asked-questions">Frequently Asked Questions</a></li>
                <li><a class="text-[#B76E79] hover:underline" href="#your-next-step">Your Next Step</a></li>
              </ul>
            </nav>

            <div class="three-month-checklist article-content prose prose-lg prose-rose max-w-none">
              <ThreeMonthWeddingPlanningChecklist />
            </div>

            <div id="frequently-asked-questions" class="space-y-4 pt-4 border-t border-[#F3E8EA]">
              <h2 class="text-xl font-bold text-[#1A1A1A]">Frequently Asked Questions</h2>
              <div class="space-y-3">
                {faqs.map(faq => (
                  <div class="bg-slate-50 p-4 rounded-2xl space-y-1">
                    <h3 class="font-bold text-sm text-[#1A1A1A]">{faq.q}</h3>
                    <p class="text-xs text-slate-600 leading-relaxed">{faq.a}</p>
                  </div>
                ))}
              </div>
            </div>
          </>
        ) : (
          <>
        
        {checklist.slug === '12-month-wedding-planning-checklist' && (
          <div class="bg-gradient-to-r from-[#FCECF0]/60 to-white border border-[#F3E8EA] p-4 rounded-2xl text-xs sm:text-sm text-slate-600 flex items-center gap-2.5 shadow-xs">
            <span class="text-[#B76E79] font-bold">💡 Tip:</span>
            <span>Planning on an accelerated or custom timeline? Learn <a href={localizeUrl('/blog/the-ultimate-wedding-planning-checklists-guide-for-a-stress-free-wedding', currentLang)} class="text-[#B76E79] font-bold hover:underline">how to choose the right wedding checklist</a> for your target wedding date.</span>
          </div>
        )}

        <!-- Summary Box -->
        <div class="bg-[#FCECF0]/30 border border-[#B76E79]/20 p-6 rounded-2xl space-y-2">
          <h2 class="text-lg font-bold text-[#B76E79]">{isPrintableWeddingChecklist ? 'Quick answer' : checklists.overviewTitle || 'Overview'}</h2>
          <p class="text-sm text-slate-700 leading-relaxed">
            {isPrintableWeddingChecklist
              ? 'If you want a wedding plan you can see at a glance, print this checklist and work through the tasks in date order. Begin with the decisions that affect everything else—budget, guest count, date, and venue—then use the later pages to track vendors, payments, final details, and notes. You can start at the month that matches your own engagement length.'
              : checklist.summary}
          </p>
        </div>

        {isPrintableWeddingChecklist && (
          <nav aria-label="Printable checklist page navigation" class="rounded-2xl border border-[#F3E8EA] bg-slate-50 p-5">
            <h2 class="mb-3 text-base font-bold text-[#1A1A1A]">On this page</h2>
            <ul class="grid grid-cols-1 gap-2 text-sm sm:grid-cols-2">
              <li><a class="text-[#B76E79] hover:underline" href="#whats-inside-printable-checklist">What is inside the checklist?</a></li>
              <li><a class="text-[#B76E79] hover:underline" href="#12-month-wedding-planning-roadmap">12-month roadmap</a></li>
              <li><a class="text-[#B76E79] hover:underline" href="#use-printable-wedding-checklist">How to use the printable</a></li>
              <li><a class="text-[#B76E79] hover:underline" href="#track-wedding-budget-and-vendors">Budget and vendor tracking</a></li>
              <li><a class="text-[#B76E79] hover:underline" href="#print-and-binder-tips">Print and binder tips</a></li>
            </ul>
          </nav>
        )}

        {checklist.slug === 'wedding-decor-flowers-checklist' && (
          <p class="text-sm text-slate-600 leading-relaxed">
            Before you choose flowers and decor, use a <a href={localizeUrl('/blog/moodboard-layout', currentLang)} class="text-[#B76E79] font-bold hover:underline">wedding moodboard</a> to share your colors, textures, and overall style with your vendors.
          </p>
        )}

        {checklist.slug === '12-month-wedding-planning-checklist' && (
          <p class="text-sm text-slate-600 leading-relaxed">
            Planning on a shorter engagement? Use the <a href={localizeUrl('/checklists/6-month-wedding-planning-checklist', currentLang)} class="text-[#B76E79] font-bold hover:underline">6-month wedding planning checklist</a> for a faster timeline.
          </p>
        )}
        {checklist.slug === '12-month-wedding-planning-checklist' && (
          <p class="text-sm text-slate-600 leading-relaxed">
            Need a faster plan? Follow the <a href={localizeUrl('/checklists/3-month-wedding-planning-checklist', currentLang)} class="text-[#B76E79] font-bold hover:underline">3 month wedding planning checklist</a> for a focused 12-week timeline.
          </p>
        )}
        {checklist.slug === '12-month-wedding-planning-checklist' && (
          <p class="text-sm text-slate-600 leading-relaxed">
            Set your spending plan early with this worked example of a <a href={localizeUrl('/checklists/wedding-budget-calculator-30k', currentLang)} class="text-[#B76E79] font-bold hover:underline">wedding budget by percentage</a>.
          </p>
        )}
        {checklist.slug === '12-month-wedding-planning-checklist' && (
          <p class="text-sm text-slate-600 leading-relaxed">
            Add your manicure dates to the plan with this guide to <a href={localizeUrl('/blog/wedding-nail-designs', currentLang)} class="text-[#B76E79] font-bold hover:underline">booking your bridal nail trial</a>.
          </p>
        )}
        {checklist.slug === 'wedding-budget-calculator-50k' && (
          <p class="text-sm text-slate-600 leading-relaxed">
            Comparing budget tiers? See how the numbers change in the <a href={localizeUrl('/checklists/wedding-budget-calculator-30k', currentLang)} class="text-[#B76E79] font-bold hover:underline">$30K wedding budget checklist</a>.
          </p>
        )}
        {checklist.slug === '3-month-wedding-planning-checklist' && (
          <p class="text-sm text-slate-600 leading-relaxed">
            If you have a little more time, follow our <a href={localizeUrl('/checklists/6-month-wedding-planning-checklist', currentLang)} class="text-[#B76E79] font-bold hover:underline">6-month wedding planning checklist</a> for a more flexible schedule.
          </p>
        )}
        {checklist.slug === 'intimate-small-wedding-checklist' && (
          <p class="text-sm text-slate-600 leading-relaxed">
            Planning on a 90-day timeline? Use our <a href={localizeUrl('/checklists/3-month-wedding-planning-checklist', currentLang)} class="text-[#B76E79] font-bold hover:underline">3 month wedding planning checklist</a> to prioritize bookings and deadlines.
          </p>
        )}
        {checklist.slug === '18-month-wedding-planning-checklist' && (
          <p class="text-sm text-slate-600 leading-relaxed">
            If your engagement is shorter, this <a href={localizeUrl('/checklists/6-month-wedding-planning-checklist', currentLang)} class="text-[#B76E79] font-bold hover:underline">6 month wedding plan</a> prioritizes the decisions that cannot wait.
          </p>
        )}
        {checklist.slug === 'printable-wedding-planning-checklist' && (
          <div class="space-y-8">
            <section id="whats-inside-printable-checklist" class="space-y-3">
              <h2 class="text-2xl font-bold text-[#1A1A1A]">What is inside the printable wedding planning checklist?</h2>
              <p class="text-sm text-slate-600 leading-relaxed">
                The free PDF is a four-page master checklist covering the decisions that shape a wedding: budget, guest list, venue, vendors, attire, stationery, final confirmations, and day-of essentials. Pages one through three move from the early months to the final week, while the final page keeps vendor contacts and payment details close to hand. It is designed to be marked up, moved into a binder, and adapted to your own plans—not followed as a rigid one-size-fits-all schedule.
              </p>
              <figure class="overflow-hidden rounded-2xl border border-[#F3E8EA] bg-slate-50 shadow-sm">
                <img src="/images/checklists/printable-wedding-planning-checklist/printable-checklist-binder-setup.webp" alt="Open printable wedding planning checklist in an organized wedding binder" width="800" height="1200" loading="lazy" decoding="async" class="w-full max-h-[720px] object-cover" />
                <figcaption class="px-4 py-3 text-xs text-slate-500">Keep the checklist in a wedding binder so decisions, quotes, and notes stay together.</figcaption>
              </figure>
            </section>

            <section id="12-month-wedding-planning-roadmap" class="space-y-4">
              <h2 class="text-2xl font-bold text-[#1A1A1A]">What should you do on a 12-month wedding planning timeline?</h2>
              <p class="text-sm text-slate-600 leading-relaxed">
                Use the monthly order as a decision guide, not a deadline you have to copy exactly. Earlier tasks unlock the choices that come later, so it helps to secure the date and core budget before you spend time on smaller details. If your wedding is closer than a year away, start from the nearest month and prioritize bookings with limited availability.
              </p>
              <div class="overflow-x-auto rounded-2xl border border-[#F3E8EA]">
                <table class="min-w-full text-left text-sm text-slate-600">
                  <thead class="bg-[#FCECF0]/50 text-[#1A1A1A]">
                    <tr><th class="px-4 py-3 font-bold">Planning stage</th><th class="px-4 py-3 font-bold">Use the checklist for</th></tr>
                  </thead>
                  <tbody class="divide-y divide-[#F3E8EA]">
                    <tr><td class="px-4 py-3 font-semibold text-slate-700">12–9 months</td><td class="px-4 py-3">Budget, guest-count estimate, date, venue, and priority vendors.</td></tr>
                    <tr><td class="px-4 py-3 font-semibold text-slate-700">8–5 months</td><td class="px-4 py-3">Attire, invitations, catering choices, ceremony details, and vendor follow-ups.</td></tr>
                    <tr><td class="px-4 py-3 font-semibold text-slate-700">4–1 months</td><td class="px-4 py-3">RSVPs, final fittings, transport, timeline details, and outstanding balances.</td></tr>
                    <tr><td class="px-4 py-3 font-semibold text-slate-700">Final week</td><td class="px-4 py-3">Confirmations, packing, hand-off notes, and a calm day-of plan.</td></tr>
                  </tbody>
                </table>
              </div>
            </section>

            <section id="use-printable-wedding-checklist" class="space-y-3">
              <h2 class="text-2xl font-bold text-[#1A1A1A]">How should you use a printable wedding checklist?</h2>
              <p class="text-sm text-slate-600 leading-relaxed">
                First, read the whole checklist without trying to complete it in one sitting. Circle the tasks that must happen first: agree a budget range, estimate guest count, choose a target date, and research venues. Next, add your own deadline beside each item and decide who owns it. Review the pages together once a week, cross out completed tasks, and move anything unfinished to a realistic new date. Use the <a href={localizeUrl('/tools/wedding-checklist-generator', currentLang)} class="text-[#B76E79] font-bold hover:underline">Wedding Checklist Generator</a> when you need a timeline built around your exact date.
              </p>
              <figure class="overflow-hidden rounded-2xl border border-[#F3E8EA] bg-slate-50 shadow-sm">
                <img src="/images/checklists/printable-wedding-planning-checklist/printable-checklist-timeline.webp" alt="Wedding checklist pages arranged with a planning timeline" width="800" height="1200" loading="lazy" decoding="async" class="w-full max-h-[720px] object-cover" />
                <figcaption class="px-4 py-3 text-xs text-slate-500">Turn each task into a date-based deadline rather than leaving it as a loose idea.</figcaption>
              </figure>
            </section>

            <section id="track-wedding-budget-and-vendors" class="space-y-3">
              <h2 class="text-2xl font-bold text-[#1A1A1A]">What should you track alongside the checklist?</h2>
              <p class="text-sm text-slate-600 leading-relaxed">
                A printed task list works best with a place for the details behind each decision. Keep vendor quotes, contract dates, deposit due dates, contact details, and your working budget beside it. Every time you sign or pay for something, update the payment tracker before moving on to the next task. Our <a href={localizeUrl('/tools/budget-calculator', currentLang)} class="text-[#B76E79] font-bold hover:underline">wedding budget calculator</a>, <a href={localizeUrl('/tools/guest-list-manager', currentLang)} class="text-[#B76E79] font-bold hover:underline">guest list manager</a>, and <a href={localizeUrl('/tools/wedding-planning-dashboard', currentLang)} class="text-[#B76E79] font-bold hover:underline">planning dashboard</a> can hold the information that is harder to fit on paper.
              </p>
              <figure class="overflow-hidden rounded-2xl border border-[#F3E8EA] bg-slate-50 shadow-sm">
                <img src="/images/checklists/printable-wedding-planning-checklist/printable-checklist-budget-vendors.webp" alt="Wedding budget and vendor planning sheets beside wedding stationery" width="800" height="1200" loading="lazy" decoding="async" class="w-full max-h-[720px] object-cover" />
                <figcaption class="px-4 py-3 text-xs text-slate-500">Track deposits and vendor details beside the tasks that depend on them.</figcaption>
              </figure>
            </section>

            <section id="print-and-binder-tips" class="space-y-3 rounded-2xl bg-[#FCECF0]/30 p-5">
              <h2 class="text-xl font-bold text-[#1A1A1A]">How can you print and organize the PDF?</h2>
              <p class="text-sm text-slate-600 leading-relaxed">
                Print on standard letter-size paper and keep the pages in a small binder or folder with clear pockets for contracts and inspiration. Print a second copy of the vendor and payment page if you have a larger celebration, or write the date you updated each section in the margin. Prefer digital planning? Save the PDF to your device for reference, then use the dashboard to keep changing numbers and deadlines in one place.
              </p>
            </section>

            <p class="text-sm text-slate-600 leading-relaxed">
              Need a shorter planning window? Use our <a href={localizeUrl('/checklists/6-month-wedding-planning-checklist', currentLang)} class="text-[#B76E79] font-bold hover:underline">6 month wedding planning guide</a> for a focused 24-week timeline, or open the printable PDF and begin with the first unchecked task today.
            </p>
          </div>
        )}

        {checklist.slug === 'indian-wedding-checklist' && (
          <p class="text-sm text-slate-600 leading-relaxed">
