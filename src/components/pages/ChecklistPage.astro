---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../layout/Header.astro';
import Footer from '../layout/Footer.astro';
import SixMonthWeddingPlanningChecklist from '../mdx/SixMonthWeddingPlanningChecklist.mdx';
import ThreeMonthWeddingPlanningChecklist from '../mdx/ThreeMonthWeddingPlanningChecklist.mdx';
import SixMonthWeddingPlanningChecklistEs from '../mdx/SixMonthWeddingPlanningChecklist.es.mdx';
import { localizeChecklist } from '../../i18n/checklists';
import GuideContent from '../guides/GuideContent.astro';
import { getGuide, getGuideFaqs } from '../guides/guides';
import checklistsData from '../../data/categorized-checklists.json';
import { generateBreadcrumbSchema, generateFAQSchema, generateArticleSchema, generateHowToSchema } from '../../lib/schema';
import { useTranslations, localizeUrl, SITE_URL } from '../../i18n/utils';
import { DEFAULT_LANGUAGE, type SupportedLanguage } from '../../i18n/config';

export interface Props {
  checklist: any;
  lang?: string;
}

const { checklist: sourceChecklist, lang = DEFAULT_LANGUAGE } = Astro.props;
const currentLang = lang as SupportedLanguage;
const checklist = localizeChecklist(sourceChecklist, currentLang);
const isEnglishThreeMonthChecklist = currentLang === DEFAULT_LANGUAGE && checklist.slug === '3-month-wedding-planning-checklist';
const { common, checklists: localChecklists } = useTranslations(currentLang);
// Fill keys a language has not translated yet with English
const checklists: any = { ...useTranslations(DEFAULT_LANGUAGE).checklists, ...localChecklists };
const slugNotes: { before: string; anchor: string; href: string; after: string }[] = checklists.slugNotes?.[checklist.slug] || [];

const canonicalUrl = currentLang === DEFAULT_LANGUAGE 
  ? `${SITE_URL}/checklists/${checklist.slug}` 
  : `${SITE_URL}/${currentLang}/checklists/${checklist.slug}`;

const seo = {
  title: checklist.seoTitle || `${checklist.title} (2026)`,
  description: checklist.metaDescription || checklist.description,
  canonical: canonicalUrl
};

const breadcrumbItems = [
  { name: common.nav.home, item: localizeUrl('/', currentLang) },
  { name: checklists.breadcrumb, item: localizeUrl('/#categorized-checklists', currentLang) },
  { name: checklist.title, item: seo.canonical }
];

const hasGuide = Boolean(getGuide('checklists', checklist.slug, currentLang));
const baseFaqs: { q: string; a: string }[] = checklist.faqs ||
  (checklists.defaultFaqs as { q: string; a: string }[]).map((f) => ({
    q: f.q.replace('{title}', checklist.title),
    a: f.a.replace('{title}', checklist.title)
  }));
// Page-specific FAQs from the guide come first; the existing ones are kept after them
const faqs: { q: string; a: string }[] = [...getGuideFaqs('checklists', checklist.slug, currentLang), ...baseFaqs];

const imageUrl = new URL(checklist.heroImage || '/wedding-planning-checklist.webp', SITE_URL).toString();
const schemas = [
  generateArticleSchema({
    title: checklist.title,
    description: seo.description,
    url: canonicalUrl,
    image: imageUrl,
    authorName: checklist.author || 'Wedding Planning Checklists Team',
    dateModified: checklist.dateModified,
    datePublished: checklist.datePublished,
    inLanguage: currentLang
  }),
  generateFAQSchema(faqs),
  generateBreadcrumbSchema(breadcrumbItems),
  checklist.howTo
    ? generateHowToSchema({ ...checklist.howTo, url: canonicalUrl })
    : null
].filter(Boolean);
const schemaGraph = schemas.map(schema => {
  const schemaData = JSON.parse(schema as string);
  if (schemaData['@type'] === 'Article') {
    schemaData['@id'] = `${canonicalUrl}#article`;
  }
  delete schemaData['@context'];
  return schemaData;
});
const combinedSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': schemaGraph
});
---

<BaseLayout title={seo.title} description={seo.description} ogTitle={seo.title} ogDescription={seo.description} titleIsFinal={Boolean(checklist.seoTitle)} canonical={seo.canonical} modifiedDate={checklist.dateModified} schemaScript={combinedSchema} lang={currentLang}>
  <Header lang={currentLang} />

  <main class="space-y-12">
    <!-- Breadcrumbs -->
    <nav class="max-w-[1300px] mx-auto px-4 pt-6 text-xs text-slate-500 flex items-center gap-2">
      <a href={localizeUrl('/', currentLang)} class="hover:text-[#B76E79]">{common.nav.home}</a>
      <span>/</span>
      <a href={localizeUrl('/#categorized-checklists', currentLang)} class="hover:text-[#B76E79]">{checklists.breadcrumb}</a>
      <span>/</span>
      <span class="text-slate-800 font-semibold">{checklist.title}</span>
    </nav>

    <!-- Page Header Hero -->
    <header class="max-w-[1300px] mx-auto px-4 space-y-4">
      <div class="inline-flex items-center gap-2 bg-[#FCECF0] text-[#B76E79] px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider">
        <span>{checklist.icon}</span>
        <span>{checklist.category} {checklists.guideSuffix}</span>
        <span>•</span>
        <span>{checklist.badge}</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-[#1A1A1A] leading-tight">
        {checklist.title}
      </h1>
      {!checklist.longForm && !isEnglishThreeMonthChecklist && (
        <p class="text-base sm:text-lg text-slate-600 max-w-3xl leading-relaxed">
          {checklist.description}
        </p>
      )}

      {currentLang !== DEFAULT_LANGUAGE && (
        <div class="inline-flex items-center gap-2 bg-white border border-[#F3E8EA] px-4 py-1.5 rounded-full text-xs text-slate-600 shadow-sm">
          <span>🌐</span>
          <span>{common.ui.translationNotice}</span>
        </div>
      )}
      
      <!-- Authorship & Date Meta -->
      <div class="flex items-center gap-4 text-xs font-medium text-slate-500 pt-2">
        <span class="inline-flex items-center gap-2">
          <div class="w-6 h-6 rounded-full bg-[#B76E79] text-white flex items-center justify-center font-bold text-[9px]">{checklist.author === 'Wedding Planning Checklists Team' ? 'W' : 'SJ'}</div>
          {common.ui.by} <strong class="text-[#1A1A1A]">{checklist.author || 'Sarah Jenkins'}</strong>
        </span>
        <span class="text-slate-300">|</span>
        <span>{common.ui.updated}: {checklist.updatedDate || 'September 6, 2026'}</span>
      </div>
    </header>

    {checklist.heroImage && (
      <div class="max-w-[1300px] mx-auto px-4">
        <img
          src={checklist.heroImage}
          alt={checklist.heroImageAlt || checklist.title}
          class="w-full aspect-video object-cover rounded-2xl border border-[#F3E8EA] shadow-sm"
          width="1376"
          height="768"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    )}

    <!-- Main Content Grid -->
    <section class="max-w-[1300px] mx-auto px-4 grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- Main Content Column -->
      <article class="lg:col-span-2 bg-white rounded-3xl border border-[#F3E8EA] p-6 sm:p-10 shadow-sm space-y-8">

        {checklist.longForm ? (
          <div class="six-month-checklist article-content prose prose-lg prose-rose max-w-none">
            {currentLang === 'es' ? <SixMonthWeddingPlanningChecklistEs /> : <SixMonthWeddingPlanningChecklist />}
          </div>
        ) : isEnglishThreeMonthChecklist ? (
          <>
            <div class="bg-[#FCECF0]/30 border border-[#B76E79]/20 p-6 rounded-2xl space-y-2">
              <h2 class="text-lg font-bold text-[#B76E79]">Summary</h2>
              <p class="text-sm text-slate-700 leading-relaxed">{checklist.summary}</p>
            </div>

            <nav aria-label="Table of contents" class="rounded-2xl border border-[#F3E8EA] bg-slate-50 p-5">
              <h2 class="mb-3 text-base font-bold text-[#1A1A1A]">On this page</h2>
              <ul class="grid grid-cols-1 gap-2 text-sm sm:grid-cols-2">
                <li><a class="text-[#B76E79] hover:underline" href="#can-you-plan-a-wedding-in-3-months">Can You Plan a Wedding in 3 Months?</a></li>
                <li><a class="text-[#B76E79] hover:underline" href="#how-to-use-this-3-month-wedding-planning-checklist">How to Use This 3 Month Wedding Planning Checklist</a></li>
                <li><a class="text-[#B76E79] hover:underline" href="#the-first-72-hours-decisions-that-unlock-everything-else">The First 72 Hours: Decisions That Unlock Everything Else</a></li>
                <li><a class="text-[#B76E79] hover:underline" href="#the-3-month-wedding-planning-checklist-at-a-glance">The 3 Month Wedding Planning Checklist at a Glance</a></li>
                <li><a class="text-[#B76E79] hover:underline" href="#weeks-12-to-10-book-the-essentials-first">Weeks 12 to 10: Book the Essentials First</a></li>
                <li><a class="text-[#B76E79] hover:underline" href="#weeks-9-to-7-style-guests-and-look">Weeks 9 to 7: Style, Guests, and Look</a></li>
                <li><a class="text-[#B76E79] hover:underline" href="#weeks-6-to-4-paperwork-details-and-logistics">Weeks 6 to 4: Paperwork, Details, and Logistics</a></li>
                <li><a class="text-[#B76E79] hover:underline" href="#weeks-3-to-2-confirm-everything">Weeks 3 to 2: Confirm Everything</a></li>
                <li><a class="text-[#B76E79] hover:underline" href="#the-final-week-rehearse-pack-and-rest">The Final Week: Rehearse, Pack, and Rest</a></li>
                <li><a class="text-[#B76E79] hover:underline" href="#what-to-book-first-simplify-or-skip">What to Book First, Simplify, or Skip</a></li>
                <li><a class="text-[#B76E79] hover:underline" href="#90-day-wedding-planning-checklist-for-a-small-budget">90 Day Wedding Planning Checklist for a Small Budget</a></li>
                <li><a class="text-[#B76E79] hover:underline" href="#planning-a-wedding-in-2-months-or-6-months">Planning a Wedding in 2 Months or 6 Months?</a></li>
                <li><a class="text-[#B76E79] hover:underline" href="#3-month-wedding-planning-checklist-pdf-and-printable-version">3 Month Wedding Planning Checklist PDF and Printable Version</a></li>
                <li><a class="text-[#B76E79] hover:underline" href="#planning-a-multi-day-south-asian-wedding-in-3-months">Planning a Multi-Day South Asian Wedding in 3 Months</a></li>
                <li><a class="text-[#B76E79] hover:underline" href="#mistakes-to-avoid-with-your-3-month-wedding-planning-checklist">Mistakes to Avoid With Your 3 Month Wedding Planning Checklist</a></li>
                <li><a class="text-[#B76E79] hover:underline" href="#frequently-asked-questions">Frequently Asked Questions</a></li>
                <li><a class="text-[#B76E79] hover:underline" href="#your-next-step">Your Next Step</a></li>
              </ul>
            </nav>

            <div class="three-month-checklist article-content prose prose-lg prose-rose max-w-none">
              <ThreeMonthWeddingPlanningChecklist />
            </div>

            <div id="frequently-asked-questions" class="space-y-4 pt-4 border-t border-[#F3E8EA]">
              <h2 class="text-xl font-bold text-[#1A1A1A]">Frequently Asked Questions</h2>
              <div class="space-y-3">
                {faqs.map(faq => (
                  <div class="bg-slate-50 p-4 rounded-2xl space-y-1">
                    <h3 class="font-bold text-sm text-[#1A1A1A]">{faq.q}</h3>
                    <p class="text-xs text-slate-600 leading-relaxed">{faq.a}</p>
                  </div>
                ))}
              </div>
            </div>
          </>
        ) : (
          <>
        
        {checklist.slug === '12-month-wedding-planning-checklist' && (
          <div class="bg-gradient-to-r from-[#FCECF0]/60 to-white border border-[#F3E8EA] p-4 rounded-2xl text-xs sm:text-sm text-slate-600 flex items-center gap-2.5 shadow-xs">
            <span class="text-[#B76E79] font-bold">{checklists.tipLabel}</span>
            <span>{checklists.tip12.before}<a href={localizeUrl(checklists.tip12.href, currentLang)} class="text-[#B76E79] font-bold hover:underline">{checklists.tip12.anchor}</a>{checklists.tip12.after}</span>
          </div>
        )}

        <!-- Summary Box -->
        <div class="bg-[#FCECF0]/30 border border-[#B76E79]/20 p-6 rounded-2xl space-y-2">
          <h2 class="text-lg font-bold text-[#B76E79]">{checklists.overviewTitle || 'Overview'}</h2>
          <p class="text-sm text-slate-700 leading-relaxed">{checklist.summary}</p>
        </div>

        {slugNotes.map((note) => (
          <p class="text-sm text-slate-600 leading-relaxed">
            {note.before}<a href={localizeUrl(note.href, currentLang)} class="text-[#B76E79] font-bold hover:underline">{note.anchor}</a>{note.after}
          </p>
        ))}

        <!-- Key Takeaways & Stages -->
        <div class="space-y-4">
          <h2 class="text-2xl font-bold text-[#1A1A1A]">{checklists.keyStepsTitle}</h2>
          <div class="space-y-3">
            {checklist.keyTakeaways.map((takeaway: string, idx: number) => (
              <div class="bg-slate-50 border border-slate-100 p-4 rounded-2xl flex items-start gap-3">
                <span class="w-6 h-6 rounded-full bg-[#B76E79] text-white text-xs font-bold flex items-center justify-center shrink-0 mt-0.5">
                  {idx + 1}
                </span>
                <p class="text-sm text-slate-700 leading-relaxed pt-0.5">{takeaway}</p>
              </div>
            ))}
          </div>
        </div>

        <hr class="border-[#F3E8EA]" />

        {hasGuide && (
          <>
            <GuideContent kind="checklists" slug={checklist.slug} lang={currentLang} />
            <hr class="border-[#F3E8EA]" />
          </>
        )}

        <!-- Deep Dive Guidance -->
        <div class="space-y-4">
          <h2 class="text-2xl font-bold text-[#1A1A1A]">{checklists.proTipsTitle}</h2>
          <p class="text-sm text-slate-600 leading-relaxed">
            {checklists.proTipsIntro}
          </p>
          <ul class="list-disc pl-5 rtl:pl-0 rtl:pr-5 space-y-2 text-sm text-slate-600">
            {checklists.proTips.map((tip: { label: string; text: string }) => (
              <li><strong>{tip.label}</strong> {tip.text}</li>
            ))}
          </ul>
        </div>

        <!-- FAQs -->
        <div class="space-y-4 pt-4 border-t border-[#F3E8EA]">
          <h2 class="text-xl font-bold text-[#1A1A1A]">{common.ui.faqs}</h2>
          <div class="space-y-3">
            {faqs.map(faq => (
              <div class="bg-slate-50 p-4 rounded-2xl space-y-1">
                <h3 class="font-bold text-sm text-[#1A1A1A]">{faq.q}</h3>
                <p class="text-xs text-slate-600 leading-relaxed">{faq.a}</p>
              </div>
            ))}
          </div>
        </div>

          </>
        )}

      </article>

      <!-- Sidebar Column -->
      <aside class="space-y-6">
        
        <!-- Interactive Tool CTA Box -->
        <div class="bg-gradient-to-br from-[#1A1A1A] to-[#2A2A2A] text-white rounded-3xl p-6 shadow-md space-y-4">
          <span class="text-[10px] font-bold uppercase tracking-wider text-[#B76E79] bg-[#FCECF0]/20 px-2.5 py-1 rounded-full">
            {common.ui.freePlanningTool}
          </span>
          <h3 class="text-xl font-bold">{checklists.trackTitle}</h3>
          <p class="text-xs text-slate-300 leading-relaxed">
            {checklists.trackText}
          </p>
          <a
            href={localizeUrl('/tools/wedding-planning-dashboard', currentLang)}
            class="block text-center bg-[#B76E79] hover:bg-[#a25d66] text-white font-bold py-3 px-4 rounded-full text-xs transition-all shadow-md"
          >
            {common.buttons.useTool} →
          </a>
        </div>

        <!-- Quick Tools Links -->
        <div class="bg-white rounded-3xl border border-[#F3E8EA] p-6 shadow-sm space-y-4">
          <h3 class="font-bold text-base text-[#1A1A1A]">{checklists.relatedToolsTitle}</h3>
          <ul class="space-y-2 text-xs font-medium">
            <li>
              <a href={localizeUrl('/tools/guest-list-manager', currentLang)} class="text-slate-600 hover:text-[#B76E79] flex items-center justify-between py-1.5 border-b border-slate-100">
                <span>👥 {common.nav.guestList}</span>
                <span class="rtl-flip">→</span>
              </a>
            </li>
            <li>
              <a href={localizeUrl('/tools/budget-calculator', currentLang)} class="text-slate-600 hover:text-[#B76E79] flex items-center justify-between py-1.5 border-b border-slate-100">
                <span>💰 {common.nav.budgetCalculator}</span>
                <span class="rtl-flip">→</span>
              </a>
            </li>
            <li>
              <a href={localizeUrl('/tools/timeline-generator', currentLang)} class="text-slate-600 hover:text-[#B76E79] flex items-center justify-between py-1.5 border-b border-slate-100">
                <span>📅 {common.footer.timelineGenerator}</span>
                <span class="rtl-flip">→</span>
              </a>
            </li>
            <li>
              <a href={localizeUrl('/tools/wedding-countdown', currentLang)} class="text-slate-600 hover:text-[#B76E79] flex items-center justify-between py-1.5">
                <span>⏰ {common.footer.weddingCountdown}</span>
                <span class="rtl-flip">→</span>
              </a>
            </li>
          </ul>
        </div>

      </aside>

    </section>

    <!-- Related Checklists Navigation -->
    <section class="max-w-[1300px] mx-auto px-4 py-8">
      <div class="bg-slate-50 rounded-3xl p-8 border border-slate-100 space-y-6">
        <h2 class="text-xl font-bold text-[#1A1A1A]">{checklists.exploreTitle}</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
          {checklistsData.checklists.filter(c => c.slug !== checklist.slug).slice(0, 4).map(source => localizeChecklist(source, currentLang)).map(item => (
            <a
              href={localizeUrl(`/checklists/${item.slug}`, currentLang)}
              class="bg-white rounded-2xl p-4 border border-[#F3E8EA] shadow-sm hover:border-[#B76E79]/40 transition-all group"
            >
              <div class="flex items-center gap-2 mb-2">
                <span class="text-base">{item.icon}</span>
                <span class="text-[10px] font-bold text-[#B76E79] uppercase">{item.category}</span>
              </div>
              <h3 class="font-bold text-xs text-[#1A1A1A] group-hover:text-[#B76E79] transition-colors leading-snug">
                {item.title}
              </h3>
            </a>
          ))}
        </div>
      </div>
    </section>

  </main>

  <Footer lang={currentLang} />
</BaseLayout>

<style>
  @media (max-width: 640px) {
    .six-month-checklist :global(table) {
      display: block;
      width: 100%;
      min-width: 0;
      max-width: 100%;
      overflow-x: auto;
      white-space: nowrap;
    }

    .three-month-checklist :global(table) {
      display: block;
      width: 100%;
      min-width: 0;
      max-width: 100%;
      overflow-x: auto;
      white-space: nowrap;
    }
  }
</style>
