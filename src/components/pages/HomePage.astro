    <!-- SECTION 16: WHY USE A WEDDING PLANNING CHECKLIST? & HOW WE BUILD OUR CONTENT -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Card 1 -->
        <div class="bg-white rounded-3xl p-8 border border-[#F3E8EA] shadow-sm space-y-4">
          <span class="text-xs font-bold uppercase tracking-wider text-[#B76E79] bg-[#FCECF0] px-3.5 py-1 rounded-full">
