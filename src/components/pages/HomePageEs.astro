---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../layout/Header.astro';
import Footer from '../layout/Footer.astro';
import toolRegistry from '../../data/tool-registry.json';
import categorizedChecklists from '../../data/categorized-checklists.json';
import { useTranslations, localizeUrl } from '../../i18n/utils';
import { localizeChecklist } from '../../i18n/checklists';
import { DEFAULT_LANGUAGE, type SupportedLanguage } from '../../i18n/config';

export interface Props {
  lang?: string;
}

const { lang = DEFAULT_LANGUAGE } = Astro.props;
const currentLang = lang as SupportedLanguage;
const { t, common, home, tools } = useTranslations(currentLang);

const siteUrl = 'https://www.weddingplanningchecklists.org';
const currentCanonical = currentLang === DEFAULT_LANGUAGE ? `${siteUrl}/` : `${siteUrl}/${currentLang}`;

const seo = {
  title: 'Lista de planificación de boda y herramientas gratis',
  description: 'Lista de boda gratis, guía paso a paso, calculadora de presupuesto y 14 herramientas. Cronogramas para cada etapa, con bodas pakistaníes e indias.',
  ogTitle: 'Lista de planificación de boda y herramientas gratuitas',
  ogDescription: 'Planifica tu boda paso a paso con una lista gratuita, una calculadora de presupuesto, cronogramas y 14 herramientas interactivas, incluidas listas para bodas pakistaníes e indias.',
  canonical: currentCanonical,
  publishDate: '2024-01-01T00:00:00Z',
  modifiedDate: '2026-09-17T00:00:00Z'
};

const faqs = [
  {
    num: 1,
    category: 'Cronograma',
    q: '¿Qué es una lista de planificación de boda?',
    a: 'Una lista de planificación de boda es una lista de tareas que divide la organización de la boda en pasos concretos y ordenados (presupuesto, lugar, lista de invitados, proveedores, atuendo y logística del día) organizados por plazos para que siempre sepas qué hacer y cuándo.'
  },
  {
    num: 2,
    category: 'Cronograma',
    q: '¿Cómo empiezo a planificar una boda?',
    a: 'Empieza fijando tu presupuesto con una calculadora de presupuesto de boda y después elige la fecha y el lugar, porque esas dos decisiones condicionan casi todas las demás, incluida la lista de invitados, las reservas de proveedores y el cronograma.'
  },
  {
    num: 3,
    category: 'Cronograma',
    q: '¿Hay una lista de planificación de boda gratuita que pueda descargar?',
    a: 'Sí. Nuestra lista gratuita está disponible en PDF imprimible, y también puedes usar el Generador de listas de boda gratuito para crear una versión personalizada según la fecha de tu boda.'
  },
  {
    num: 4,
    category: 'Cronograma',
    q: '¿Qué es un cronograma de planificación de boda?',
    a: 'Un cronograma de boda asigna cada tarea a meses o semanas concretos antes de la boda, para que hagas cosas como reservar el lugar o enviar las invitaciones en el momento adecuado y no demasiado pronto o, peor aún, demasiado tarde.'
  },
  {
    num: 5,
    category: 'Cronograma',
    q: '¿Con cuánta antelación debo empezar a planificar la boda?',
    a: 'La mayoría de las parejas empiezan entre 12 y 18 meses antes de la boda, aunque una lista acelerada de 6 o de 3 meses funciona bien para compromisos más cortos.'
  },
  {
    num: 6,
    category: 'Presupuesto',
    q: '¿Qué debe incluir una lista de presupuesto de boda?',
    a: 'Una lista de presupuesto de boda debe dividir el presupuesto total en categorías (lugar, catering, fotografía, atuendo, flores y entretenimiento) con un porcentaje o un rango de importe recomendado para cada una.'
  },
  {
    num: 7,
    category: 'Proveedores',
    q: '¿Tenéis listas para bodas pakistaníes o indias?',
    a: 'Sí. Tenemos una lista específica para bodas pakistaníes y musulmanas de varios días y una lista maestra para bodas indias, ambas organizadas según la secuencia completa de eventos de varios días y no en formato de un solo día.'
  },
  {
    num: 8,
    category: 'Cronograma',
    q: '¿Qué es un generador de listas de boda?',
    a: 'Un generador de listas de boda es una herramienta interactiva que crea una lista de planificación personalizada según la fecha de tu boda y ordena automáticamente las tareas por plazo, en lugar de darte una lista genérica para todo el mundo.'
  },
  {
    num: 9,
    category: 'Cronograma',
    q: '¿Qué diferencia hay entre una lista de planificación de boda y el cronograma del día de la boda?',
    a: 'La lista de planificación cubre todo lo previo a la boda, durante meses o un año, mientras que el cronograma del día cubre solo las horas del propio día de la boda, desde la peluquería y el maquillaje hasta el último baile.'
  },
  {
    num: 10,
    category: 'Proveedores',
    q: '¿Las herramientas de planificación de esta web son realmente gratuitas?',
    a: 'Sí. Las 14 herramientas interactivas, incluidas la Calculadora de presupuesto, el Gestor de invitados y el Generador de listas, son gratuitas.'
  }
];

const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://www.weddingplanningchecklists.org/#website",
      "url": "https://www.weddingplanningchecklists.org/",
      "name": "WeddingPlanningChecklists.org",
      "description": "Listas de planificación de boda gratuitas, cronogramas, calculadora de presupuesto y herramientas interactivas de planificación.",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://www.weddingplanningchecklists.org/?s={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "Organization",
      "@id": "https://www.weddingplanningchecklists.org/#organization",
      "name": "WeddingPlanningChecklists.org",
      "url": "https://www.weddingplanningchecklists.org/",
      "sameAs": []
    },
    {
      "@type": "CollectionPage",
      "@id": "https://www.weddingplanningchecklists.org/es#webpage",
      "url": "https://www.weddingplanningchecklists.org/es",
      "inLanguage": "es",
      "name": "Lista de planificación de boda: guía gratuita, cronogramas, calculadora de presupuesto y herramientas",
      "isPartOf": { "@id": "https://www.weddingplanningchecklists.org/#website" },
      "about": { "@id": "https://www.weddingplanningchecklists.org/#organization" },
      "description": "Lista de planificación de boda gratuita, guía paso a paso, calculadora de presupuesto y 14 herramientas con cronogramas para cada etapa.",
      "datePublished": seo.publishDate,
      "dateModified": seo.modifiedDate
    },
    {
      "@type": "FAQPage",
      "@id": "https://www.weddingplanningchecklists.org/es#faq",
      "mainEntity": faqs.map(faq => ({
        "@type": "Question",
        "name": faq.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.a
        }
      }))
    }
  ]
};

const combinedSchema = JSON.stringify(schemaGraph);
---

<BaseLayout 
  title={seo.title}
  titleIsFinal={true}
  description={seo.description} 
  ogTitle={seo.ogTitle}
  ogDescription={seo.ogDescription}
  canonical={seo.canonical} 
  image="/wedding-planning-checklist-hero.jpg"
  publishDate={seo.publishDate}
  modifiedDate={seo.modifiedDate}
  schemaScript={combinedSchema} 
  lang={currentLang}
>
  <Header lang={currentLang} />

  <main class="space-y-16 sm:space-y-24">
    <!-- SECTION 1: HERO SECTION -->
    <section class="relative pt-12 pb-16 lg:pt-20 lg:pb-24 overflow-hidden bg-gradient-to-b from-[#FCECF0]/60 via-white to-transparent">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 text-center space-y-6">
        <div class="inline-flex items-center gap-2 bg-[#FCECF0] text-[#B76E79] px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider shadow-sm border border-[#F3E8EA]">
          <span class="w-2 h-2 rounded-full bg-[#B76E79] animate-pulse"></span>
          <span>Guía gratuita para planificar tu boda y 14 herramientas interactivas</span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-[#1A1A1A] leading-[1.15] tracking-tight font-serif max-w-5xl mx-auto">
          Lista de planificación de boda: <span class="text-[#B76E79]">guía gratuita</span>, cronogramas, calculadora de presupuesto y herramientas
        </h1>

        <p class="text-base sm:text-lg lg:text-xl text-slate-600 max-w-4xl mx-auto leading-relaxed font-normal">
          Planificar una boda no tiene por qué ser abrumador. WeddingPlanningChecklists.org ofrece a las parejas prometidas una lista de planificación de boda gratuita, una guía completa paso a paso y una biblioteca de herramientas interactivas pensadas para responder a una pregunta en cada etapa: <strong>¿qué hago ahora?</strong> En lugar de notas sueltas, hojas de cálculo a medias y consejos genéricos, tienes un cronograma real, una calculadora de presupuesto, un gestor de la lista de invitados y listas imprimibles organizadas por meses, por presupuesto y por cultura, incluidas listas específicas para bodas pakistaníes, indias y del sur de Asia. Cada herramienta y cada lista de esta web persiguen el mismo objetivo: ayudarte a pasar de «¿por dónde empiezo?» a un día de boda totalmente organizado, sin olvidar ni una sola tarea.
        </p>

        <!-- Primary Hero Action Buttons -->
        <div class="flex flex-wrap justify-center gap-4 pt-2">
          <a 
            href={localizeUrl('/checklists/printable-wedding-planning-checklist', currentLang)} 
            class="bg-[#B76E79] hover:bg-[#a25d66] text-white px-8 py-4 rounded-full text-sm sm:text-base font-bold shadow-lg shadow-[#B76E79]/20 transition-all transform hover:-translate-y-0.5 flex items-center gap-2"
          >
            <span>📥 Descargar la lista gratis (PDF)</span>
          </a>
          <a 
            href={localizeUrl('/tools/wedding-checklist-generator', currentLang)} 
            class="bg-white hover:bg-[#FCECF0]/40 text-[#1A1A1A] border-2 border-[#B76E79]/30 px-8 py-4 rounded-full text-sm sm:text-base font-bold transition-all shadow-sm flex items-center gap-2"
          >
            <span>⚡ Generador de listas de boda gratis</span>
          </a>
          <a 
            href={localizeUrl('/tools/wedding-planning-dashboard', currentLang)} 
            class="bg-slate-900 hover:bg-slate-800 text-white px-8 py-4 rounded-full text-sm sm:text-base font-bold transition-all shadow-md flex items-center gap-2"
          >
            <span>📊 Panel de planificación de boda</span>
          </a>
        </div>

        <!-- Social Proof Stats (User Screenshot design) -->
        <div class="pt-10 grid grid-cols-2 sm:grid-cols-4 max-w-4xl mx-auto gap-6 border-t border-[#F3E8EA] mt-10 text-center">
          <div class="p-4 rounded-2xl bg-white border border-[#F3E8EA]/60 shadow-xs">
            <p class="text-3xl sm:text-4xl font-black text-[#1A1A1A]">14</p>
            <p class="text-xs sm:text-sm text-slate-500 font-medium mt-1">Herramientas interactivas</p>
          </div>
          <div class="p-4 rounded-2xl bg-white border border-[#F3E8EA]/60 shadow-xs">
            <p class="text-3xl sm:text-4xl font-black text-[#B76E79]">20+</p>
            <p class="text-xs sm:text-sm text-slate-500 font-medium mt-1">Listas imprimibles</p>
          </div>
          <div class="p-4 rounded-2xl bg-white border border-[#F3E8EA]/60 shadow-xs">
            <p class="text-3xl sm:text-4xl font-black text-[#D4AF37]">$10k–$50k+</p>
            <p class="text-xs sm:text-sm text-slate-500 font-medium mt-1">Guías de presupuesto</p>
          </div>
          <div class="p-4 rounded-2xl bg-white border border-[#F3E8EA]/60 shadow-xs">
            <p class="text-3xl sm:text-4xl font-black text-[#1A1A1A]">100%</p>
            <p class="text-xs sm:text-sm text-slate-500 font-medium mt-1">Herramientas gratis y sin anuncios</p>
          </div>
        </div>

        <!-- HERO IMAGE (16:9) -->
        <figure class="relative max-w-5xl mx-auto mt-10 rounded-3xl overflow-hidden shadow-2xl border border-[#F3E8EA] bg-white group">
          <img 
            src="/wedding-planning-checklist-hero.jpg" 
            alt="Lista de planificación de boda gratuita y planificador de presupuesto sobre una mesa" 
            width="1200" 
            height="675" 
            class="w-full h-auto object-cover transform group-hover:scale-[1.01] transition-transform duration-500" 
            loading="eager" 
            fetchpriority="high" 
          />
          <figcaption class="p-4 bg-white/95 backdrop-blur-sm border-t border-slate-100 text-xs sm:text-sm text-slate-600 flex flex-wrap items-center justify-between gap-2">
            <span class="font-medium text-[#1A1A1A]">Bodegón editorial: lista de planificación, hoja de presupuesto y cronograma</span>
            <span class="text-[#B76E79] font-bold">Recursos 100 % gratuitos &bull; Actualizado para 2026</span>
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- SECTION 2: WHAT IS WEDDINGPLANNINGCHECKLISTS.ORG? -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white rounded-3xl p-8 sm:p-12 border border-[#F3E8EA] shadow-sm space-y-8">
        <div class="max-w-3xl space-y-4">
          <span class="text-xs font-bold uppercase tracking-wider text-[#B76E79] bg-[#FCECF0] px-3.5 py-1 rounded-full">
            Nuestra misión y nuestro ecosistema de planificación
          </span>
          <h2 class="text-2xl sm:text-4xl font-black text-[#1A1A1A] font-serif">
            ¿Qué es WeddingPlanningChecklists.org?
          </h2>
          <p class="text-slate-600 text-base sm:text-lg leading-relaxed">
            WeddingPlanningChecklists.org es un centro de recursos para planificar bodas construido en torno a cuatro ideas que toda pareja necesita: <strong>listas, cronogramas, calculadoras y seguimiento</strong>. En lugar de un único artículo larguísimo que intenta explicar una boda entera, la web está organizada como un sistema conectado: nuestra <a href={localizeUrl('/blog/the-ultimate-wedding-planning-checklists-guide-for-a-stress-free-wedding', currentLang)} class="text-[#B76E79] font-bold underline hover:text-[#a25d66]">guía de listas de planificación de boda</a> enlaza directamente con el cronograma, el nivel de presupuesto o la lista de proveedores que necesitas en cada etapa. La web incluye 14 herramientas interactivas, más de 20 listas descargables e imprimibles y una biblioteca creciente de guías que abarcan desde el presupuesto, la lista de invitados y los contratos con proveedores hasta los peinados de novia y las tradiciones de las bodas culturales de varios días. El objetivo de cada página es sencillo: dar a novias, novios y organizadoras un único lugar para planificar, organizar, calcular y seguir cada tarea desde el compromiso hasta el «sí, quiero», en lugar de reunir información de una docena de webs distintas.
          </p>
        </div>

        <!-- 4 Core Pillars Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 pt-4">
          <div class="p-6 rounded-2xl bg-[#FAFAFA] border border-slate-100 space-y-3 hover:border-[#B76E79]/30 transition-all">
            <div class="w-12 h-12 rounded-xl bg-[#FCECF0] text-[#B76E79] flex items-center justify-center text-2xl font-bold">✓</div>
            <h3 class="font-bold text-lg text-[#1A1A1A]">1. Listas maestras</h3>
            <p class="text-xs sm:text-sm text-slate-500 leading-relaxed">
              Carpetas en PDF imprimibles, calendarios de tareas mensuales y listas de emergencia para el día, en orden cronológico.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-[#FAFAFA] border border-slate-100 space-y-3 hover:border-[#B76E79]/30 transition-all">
            <div class="w-12 h-12 rounded-xl bg-[#FCECF0] text-[#B76E79] flex items-center justify-center text-2xl font-bold">📅</div>
            <h3 class="font-bold text-lg text-[#1A1A1A]">2. Cronogramas reales</h3>
            <p class="text-xs sm:text-sm text-slate-500 leading-relaxed">
              Cuentas regresivas a medida de 18 a 3 meses y generadores del horario del día de la boda hora a hora.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-[#FAFAFA] border border-slate-100 space-y-3 hover:border-[#B76E79]/30 transition-all">
            <div class="w-12 h-12 rounded-xl bg-[#FCECF0] text-[#B76E79] flex items-center justify-center text-2xl font-bold">💰</div>
            <h3 class="font-bold text-lg text-[#1A1A1A]">3. Calculadoras de presupuesto</h3>
            <p class="text-xs sm:text-sm text-slate-500 leading-relaxed">
              Límites de gasto por categoría para presupuestos de 10.000 $, 20.000 $, 30.000 $ y más de 50.000 $, con control de pagos a proveedores.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-[#FAFAFA] border border-slate-100 space-y-3 hover:border-[#B76E79]/30 transition-all">
            <div class="w-12 h-12 rounded-xl bg-[#FCECF0] text-[#B76E79] flex items-center justify-center text-2xl font-bold">📊</div>
            <h3 class="font-bold text-lg text-[#1A1A1A]">4. Seguimiento en tiempo real</h3>
            <p class="text-xs sm:text-sm text-slate-500 leading-relaxed">
              Panel de boda unificado, organizador de invitados y confirmaciones, control de dietas y avisos de plazos e hitos.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 3: KEY FEATURES OVERVIEW (OLD DESIGN) -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <div class="text-center space-y-3 mb-12">
        <h2 class="text-3xl font-black text-[#1A1A1A]">{home.features.title}</h2>
        <p class="text-slate-600 text-sm max-w-xl mx-auto">{home.features.subtitle}</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <a href={localizeUrl('/tools/wedding-checklist-generator', currentLang)} class="bg-white rounded-3xl p-6 border border-[#F3E8EA] shadow-sm space-y-3 hover:border-[#B76E79]/40 hover:shadow-md transition-all group block">
          <div class="w-10 h-10 rounded-2xl bg-[#FCECF0] text-[#B76E79] flex items-center justify-center font-bold text-lg">✓</div>
          <h3 class="font-bold text-lg text-[#1A1A1A] group-hover:text-[#B76E79] transition-colors">{(tools.tools as any)['wedding-checklist-generator']?.title || 'Smart Checklist'}</h3>
          <p class="text-xs text-slate-500 leading-relaxed">{(tools.tools as any)['wedding-checklist-generator']?.description || 'Manage every detail with our priority-sorted task manager organized by timeline.'}</p>
        </a>

        <a href={localizeUrl('/tools/guest-list-manager', currentLang)} class="bg-white rounded-3xl p-6 border border-[#F3E8EA] shadow-sm space-y-3 hover:border-[#B76E79]/40 hover:shadow-md transition-all group block">
          <div class="w-10 h-10 rounded-2xl bg-[#FCECF0] text-[#B76E79] flex items-center justify-center font-bold text-lg">👥</div>
          <h3 class="font-bold text-lg text-[#1A1A1A] group-hover:text-[#B76E79] transition-colors">{(tools.tools as any)['guest-list-manager']?.title || 'Guest List'}</h3>
          <p class="text-xs text-slate-500 leading-relaxed">{(tools.tools as any)['guest-list-manager']?.description || 'Keep track of RSVPs, dietary needs, meal choices, seating, and plus-ones easily.'}</p>
        </a>

        <a href={localizeUrl('/tools/budget-calculator', currentLang)} class="bg-white rounded-3xl p-6 border border-[#F3E8EA] shadow-sm space-y-3 hover:border-[#B76E79]/40 hover:shadow-md transition-all group block">
          <div class="w-10 h-10 rounded-2xl bg-[#FCECF0] text-[#B76E79] flex items-center justify-center font-bold text-lg">💰</div>
          <h3 class="font-bold text-lg text-[#1A1A1A] group-hover:text-[#B76E79] transition-colors">{(tools.tools as any)['budget-calculator']?.title || 'Budget Tracker'}</h3>
          <p class="text-xs text-slate-500 leading-relaxed">{(tools.tools as any)['budget-calculator']?.description || 'Never overspend with real-time allocation across venue, catering, photo & buffer.'}</p>
        </a>

        <a href={localizeUrl('/tools/timeline-generator', currentLang)} class="bg-white rounded-3xl p-6 border border-[#F3E8EA] shadow-sm space-y-3 hover:border-[#B76E79]/40 hover:shadow-md transition-all group block">
          <div class="w-10 h-10 rounded-2xl bg-[#FCECF0] text-[#B76E79] flex items-center justify-center font-bold text-lg">📅</div>
          <h3 class="font-bold text-lg text-[#1A1A1A] group-hover:text-[#B76E79] transition-colors">{(tools.tools as any)['timeline-generator']?.title || 'Timeline Planner'}</h3>
          <p class="text-xs text-slate-500 leading-relaxed">{(tools.tools as any)['timeline-generator']?.description || 'Visual milestone maps and time-blocked daily schedules for your big day.'}</p>
        </a>
      </div>
    </section>

    <!-- SECTION 4: 14 INTERACTIVE PLANNING TOOLS GRID (OLD DESIGN) -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <div class="text-center space-y-3 mb-12">
        <span class="text-xs font-bold text-[#B76E79] uppercase tracking-wider">{home.features.toolsBadge}</span>
        <h2 class="text-3xl sm:text-4xl font-black text-[#1A1A1A]">14 herramientas interactivas gratuitas para planificar tu boda</h2>
        <p class="text-slate-600 max-w-xl mx-auto text-sm">
          Todas las herramientas se sincronizan con la fecha de tu boda y guardan tu progreso de forma segura en tu navegador.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
        {toolRegistry.tools.map(tool => {
          const localizedTool = tools.tools[tool.id as keyof typeof tools.tools] || tool;
          return (
            <a
              href={localizeUrl(tool.href, currentLang)}
              class="bg-white rounded-3xl p-6 border border-[#F3E8EA] shadow-sm hover:shadow-md hover:border-[#B76E79]/40 transition-all group flex flex-col justify-between"
            >
              <div class="space-y-3">
                <span class="inline-block text-[10px] font-bold uppercase tracking-wider text-[#B76E79] bg-[#FCECF0] px-2.5 py-1 rounded-full">
                  {localizedTool.category || tool.category}
                </span>
                <h3 class="font-bold text-lg text-[#1A1A1A] group-hover:text-[#B76E79] transition-colors">{localizedTool.title || tool.title}</h3>
                <p class="text-xs text-slate-500 leading-relaxed">{localizedTool.description || tool.description}</p>
              </div>
              <div class="pt-4 flex items-center gap-1 text-xs font-bold text-[#B76E79]">
                <span>{common.buttons.useTool}</span>
                <span class="group-hover:translate-x-1 rtl:group-hover:-translate-x-1 transition-transform rtl-flip">→</span>
              </div>
            </a>
          );
        })}
      </div>
    </section>

    <!-- SECTION 5: 20 CATEGORIZED CHECKLISTS & TOOL GUIDES (OLD DESIGN) -->
