---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../layout/Header.astro';
import Footer from '../layout/Footer.astro';
import toolRegistry from '../../data/tool-registry.json';
import { generateBreadcrumbSchema, generateWebApplicationSchema, generateFAQSchema } from '../../lib/schema';
import GuideContent from '../guides/GuideContent.astro';
import { getGuide, getGuideFaqs } from '../guides/guides';
import { useTranslations, localizeUrl, SITE_URL } from '../../i18n/utils';
import { DEFAULT_LANGUAGE, type SupportedLanguage } from '../../i18n/config';

// Import 8 core interactive tool components
import { BudgetCalculator } from '../tools/BudgetCalculator';
import { TimelineGenerator } from '../tools/TimelineGenerator';
import { GuestListManager } from '../tools/GuestListManager';
import { ChecklistGenerator } from '../tools/ChecklistGenerator';
import { PlanningTimeline } from '../tools/PlanningTimeline';
import { PlanningCalendar } from '../tools/PlanningCalendar';
import { WeddingCountdown } from '../tools/WeddingCountdown';
import { PlanningDashboard } from '../tools/PlanningDashboard';

export interface Props {
  toolId: string;
  lang?: string;
}

const { toolId, lang = DEFAULT_LANGUAGE } = Astro.props;
const currentLang = lang as SupportedLanguage;
const { common, tools } = useTranslations(currentLang);

const baseTool = toolRegistry.tools.find(t => t.id === toolId) || toolRegistry.tools[0];
const localizedTool = (tools.tools as any)[toolId] || baseTool;

const title = localizedTool.title || baseTool.title;
const description = localizedTool.description || baseTool.description;
const category = localizedTool.category || baseTool.category;
const intro = localizedTool.intro || description;

const canonicalUrl = currentLang === DEFAULT_LANGUAGE 
  ? `${SITE_URL}/tools/${toolId}` 
  : `${SITE_URL}/${currentLang}/tools/${toolId}`;

// Translated tool names are longer, so they skip the site-name suffix to stay under ~65 characters
const seo = {
  title: currentLang === DEFAULT_LANGUAGE ? `${title} (2026)` : `${title} gratis (2026)`,
  description,
  canonical: canonicalUrl
};

const breadcrumbItems = [
  { name: common.nav.home, item: localizeUrl('/', currentLang) },
  { name: common.footer.suiteTitle, item: localizeUrl('/tools/wedding-planning-dashboard', currentLang) },
  { name: title, item: canonicalUrl }
];

const hasGuide = Boolean(getGuide('tools', toolId, currentLang));
const guideFaqs = getGuideFaqs('tools', toolId, currentLang);

const schema = `[${[
  generateWebApplicationSchema({ name: title, description, url: canonicalUrl }),
  generateBreadcrumbSchema(breadcrumbItems),
  generateFAQSchema(guideFaqs, canonicalUrl)
].filter(Boolean).join(',')}]`;
---

<BaseLayout title={seo.title} titleIsFinal={currentLang !== DEFAULT_LANGUAGE} description={seo.description} canonical={seo.canonical} schemaScript={schema} lang={currentLang}>
  <Header lang={currentLang} />

  <main class="py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Breadcrumbs -->
    <nav class="max-w-4xl mx-auto mb-8" aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-1.5 text-xs text-slate-400">
        {breadcrumbItems.map((crumb, idx) => (
          <li class="flex items-center gap-1.5">
            {idx > 0 && <span aria-hidden="true" class="rtl-flip">/</span>}
            {idx === breadcrumbItems.length - 1 ? (
              <span class="font-semibold text-[#B76E79]">{crumb.name}</span>
            ) : (
              <a href={crumb.item} class="hover:text-[#B76E79] transition-colors">{crumb.name}</a>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <!-- Tool Header Hero -->
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-8">
      <span class="text-xs font-bold text-[#B76E79] uppercase tracking-wider bg-[#FCECF0] px-3 py-1 rounded-full">
        {category} • {common.ui.freePlanningTool}
      </span>
      <h1 class="text-3xl sm:text-5xl font-black text-[#1A1A1A] tracking-tight">{title}</h1>
      <p class="text-slate-600 text-sm sm:text-base leading-relaxed max-w-2xl mx-auto">
        {description}
      </p>

      {currentLang !== DEFAULT_LANGUAGE && (
        <div class="inline-flex items-center gap-2 bg-white border border-[#F3E8EA] px-4 py-1.5 rounded-full text-xs text-slate-600 shadow-sm mt-2">
          <span>🌐</span>
          <span>{common.ui.translationNotice}</span>
        </div>
      )}
    </div>

    <!-- SEO Intro Copy -->
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pt-2 pb-8 text-center text-slate-600 text-xs sm:text-sm leading-relaxed">
      {intro}
    </div>

    <!-- Dynamic Interactive Tool Component Mount -->
    <div class="mt-4">
      {(toolId === 'budget-calculator') && <BudgetCalculator client:visible lang={currentLang} />}
      {(toolId === 'timeline-generator') && <TimelineGenerator client:visible lang={currentLang} />}
      {(toolId === 'guest-list-manager') && <GuestListManager client:visible lang={currentLang} />}
      {(toolId === 'wedding-checklist-generator' || toolId === 'checklist-generator') && <ChecklistGenerator client:visible lang={currentLang} />}
      {(toolId === 'wedding-planning-timeline' || toolId === 'planning-timeline') && <PlanningTimeline client:visible lang={currentLang} />}
      {(toolId === 'wedding-planning-calendar' || toolId === 'planning-calendar') && <PlanningCalendar client:visible lang={currentLang} />}
      {(toolId === 'wedding-countdown') && <WeddingCountdown client:visible lang={currentLang} />}
      {(toolId === 'wedding-planning-dashboard' || toolId === 'planning-dashboard') && <PlanningDashboard client:visible lang={currentLang} />}
    </div>

    <!-- Long-form guide for this tool -->
    {hasGuide && (
    <article class="max-w-4xl mx-auto mt-16 bg-white rounded-3xl border border-[#F3E8EA] p-6 sm:p-10 shadow-sm">
      <GuideContent kind="tools" slug={toolId} lang={currentLang} />

      {guideFaqs.length > 0 && (
        <div class="space-y-4 pt-8 mt-8 border-t border-[#F3E8EA]">
          <h2 class="text-xl font-bold text-[#1A1A1A]">{common.ui.faqs}</h2>
          <div class="space-y-3">
            {guideFaqs.map(faq => (
              <div class="bg-slate-50 p-4 rounded-2xl space-y-1">
                <h3 class="font-bold text-sm text-[#1A1A1A]">{faq.q}</h3>
                <p class="text-sm text-slate-600 leading-relaxed">{faq.a}</p>
              </div>
            ))}
          </div>
        </div>
      )}
    </article>
    )}
  </main>

  <Footer lang={currentLang} />
</BaseLayout>
