---
import { useTranslations, localizeUrl, getLangFromPath } from '../../i18n/utils';
import { DEFAULT_LANGUAGE, type SupportedLanguage } from '../../i18n/config';

export interface Props {
  lang?: string;
}

const { lang } = Astro.props;
const currentLang = (lang || getLangFromPath(Astro.url.pathname)) as SupportedLanguage;
const { common } = useTranslations(currentLang);
const footer = common.footer;
---

<footer class="bg-[#1A1A1A] text-white pt-16 pb-12 mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-5 gap-10">
    <!-- Brand / Intro -->
    <div class="space-y-4 md:col-span-1">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-full bg-[#B76E79] text-white flex items-center justify-center font-bold text-base shrink-0">W</div>
        <span class="font-bold text-base text-white">WeddingPlanningChecklists</span>
      </div>
      <p class="text-xs text-slate-400 leading-relaxed">
        {footer.aboutText}
      </p>
    </div>

    <!-- Col 1: Planning Suite -->
    <div>
      <h4 class="font-bold text-xs text-[#B76E79] uppercase tracking-wider mb-4">{footer.suiteTitle}</h4>
      <ul class="space-y-2 text-xs text-slate-300">
        <li><a href={localizeUrl('/tools/wedding-planning-dashboard', currentLang)} class="hover:text-white transition-colors">{footer.planningDashboard}</a></li>
        <li><a href={localizeUrl('/tools/budget-calculator', currentLang)} class="hover:text-white transition-colors">{footer.budgetCalculator}</a></li>
        <li><a href={localizeUrl('/tools/guest-list-manager', currentLang)} class="hover:text-white transition-colors">{footer.guestListManager}</a></li>
        <li><a href={localizeUrl('/tools/wedding-checklist-generator', currentLang)} class="hover:text-white transition-colors">{footer.checklistGenerator}</a></li>
        <li><a href={localizeUrl('/tools/wedding-countdown', currentLang)} class="hover:text-white transition-colors">{footer.weddingCountdown}</a></li>
      </ul>
    </div>

    <!-- Col 2: Timelines & Tasks -->
    <div>
      <h4 class="font-bold text-xs text-[#B76E79] uppercase tracking-wider mb-4">{footer.timelinesTitle}</h4>
      <ul class="space-y-2 text-xs text-slate-300">
        <li><a href={localizeUrl('/tools/timeline-generator', currentLang)} class="hover:text-white transition-colors">{footer.timelineGenerator}</a></li>
        <li><a href={localizeUrl('/tools/wedding-planning-timeline', currentLang)} class="hover:text-white transition-colors">{footer.planningTimeline}</a></li>
        <li><a href={localizeUrl('/tools/wedding-task-generator', currentLang)} class="hover:text-white transition-colors">{footer.taskGenerator}</a></li>
        <li><a href={localizeUrl('/tools/wedding-milestone-tracker', currentLang)} class="hover:text-white transition-colors">{footer.milestoneTracker}</a></li>
        <li><a href={localizeUrl('/tools/wedding-progress-tracker', currentLang)} class="hover:text-white transition-colors">{footer.progressTracker}</a></li>
      </ul>
    </div>

    <!-- Col 3: Calendars & Planners -->
    <div>
      <h4 class="font-bold text-xs text-[#B76E79] uppercase tracking-wider mb-4">{footer.calendarsTitle}</h4>
      <ul class="space-y-2 text-xs text-slate-300">
        <li><a href={localizeUrl('/tools/wedding-planning-calendar', currentLang)} class="hover:text-white transition-colors">{footer.planningCalendar}</a></li>
        <li><a href={localizeUrl('/tools/daily-wedding-planner', currentLang)} class="hover:text-white transition-colors">{footer.dailyPlanner}</a></li>
        <li><a href={localizeUrl('/tools/weekly-wedding-planner', currentLang)} class="hover:text-white transition-colors">{footer.weeklyPlanner}</a></li>
        <li><a href={localizeUrl('/tools/monthly-wedding-planner', currentLang)} class="hover:text-white transition-colors">{footer.monthlyPlanner}</a></li>
      </ul>
    </div>

    <!-- Col 4: Popular Guides & Legal -->
    <div>
      <h4 class="font-bold text-xs text-[#B76E79] uppercase tracking-wider mb-4">{footer.guidesTitle}</h4>
      <ul class="space-y-2 text-xs text-slate-300">
        <li><a href={localizeUrl('/blog/18-month-wedding-planning-timeline', currentLang)} class="hover:text-white transition-colors">{footer.timeline18Month}</a></li>
        <li><a href={localizeUrl('/blog/14-month-wedding-planning-timeline', currentLang)} class="hover:text-white transition-colors">{footer.timeline14Month}</a></li>
        <li><a href={localizeUrl('/blog/hairstyles-for-wedding', currentLang)} class="hover:text-white transition-colors">{footer.bridalHairstyles}</a></li>
        <li><a href={localizeUrl('/blog/how-to-choose-wedding-venue', currentLang)} class="hover:text-white transition-colors">{footer.venueSelection}</a></li>
        <li><a href={localizeUrl('/sitemap', currentLang)} class="hover:text-white transition-colors">{footer.sitemap}</a></li>
        <li><a href={localizeUrl('/privacy-policy', currentLang)} class="hover:text-white transition-colors">{footer.privacyPolicy}</a></li>
      </ul>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-12 pt-8 border-t border-slate-800 text-center text-xs text-slate-500">
    {footer.copyright}
  </div>
</footer>
