---
import toolRegistry from '../../data/tool-registry.json';
---

<footer class="bg-[#1A1A1A] text-white pt-16 pb-12 mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-5 gap-10">
    <div class="space-y-4 md:col-span-1">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-full bg-[#B76E79] text-white flex items-center justify-center font-bold text-base">W</div>
        <span class="font-bold text-base text-white">WeddingPlanningChecklists</span>
      </div>
      <p class="text-xs text-slate-400 leading-relaxed">
        Your ultimate resource for stress-free wedding planning. 14+ free interactive planning tools, timeline guides, and verified checklists.
      </p>
    </div>

    <div>
      <h4 class="font-bold text-xs text-[#B76E79] uppercase tracking-wider mb-4">Planning Suite</h4>
      <ul class="space-y-2 text-xs text-slate-300">
        <li><a href="/tools/wedding-planning-dashboard" class="hover:text-white transition-colors">Planning Dashboard</a></li>
        <li><a href="/tools/budget-calculator" class="hover:text-white transition-colors">Budget Calculator</a></li>
        <li><a href="/tools/guest-list-manager" class="hover:text-white transition-colors">Guest List Manager</a></li>
        <li><a href="/tools/wedding-checklist-generator" class="hover:text-white transition-colors">Checklist Generator</a></li>
        <li><a href="/tools/wedding-countdown" class="hover:text-white transition-colors">Wedding Countdown</a></li>
      </ul>
    </div>

    <div>
      <h4 class="font-bold text-xs text-[#B76E79] uppercase tracking-wider mb-4">Timelines & Tasks</h4>
      <ul class="space-y-2 text-xs text-slate-300">
        <li><a href="/tools/timeline-generator" class="hover:text-white transition-colors">Day-of Timeline</a></li>
        <li><a href="/tools/wedding-planning-timeline" class="hover:text-white transition-colors">Planning Timeline</a></li>
        <li><a href="/tools/wedding-task-generator" class="hover:text-white transition-colors">Task Generator</a></li>
        <li><a href="/tools/wedding-milestone-tracker" class="hover:text-white transition-colors">Milestone Tracker</a></li>
        <li><a href="/tools/wedding-progress-tracker" class="hover:text-white transition-colors">Progress Tracker</a></li>
      </ul>
    </div>

    <div>
      <h4 class="font-bold text-xs text-[#B76E79] uppercase tracking-wider mb-4">Calendars & Planners</h4>
      <ul class="space-y-2 text-xs text-slate-300">
        <li><a href="/tools/wedding-planning-calendar" class="hover:text-white transition-colors">Planning Calendar</a></li>
        <li><a href="/tools/daily-wedding-planner" class="hover:text-white transition-colors">Daily Planner</a></li>
        <li><a href="/tools/weekly-wedding-planner" class="hover:text-white transition-colors">Weekly Planner</a></li>
        <li><a href="/tools/monthly-wedding-planner" class="hover:text-white transition-colors">Monthly Planner</a></li>
      </ul>
    </div>

    <div>
      <h4 class="font-bold text-xs text-[#B76E79] uppercase tracking-wider mb-4">Popular Guides</h4>
      <ul class="space-y-2 text-xs text-slate-300">
        <li><a href="/blog/18-month-wedding-planning-timeline" class="hover:text-white transition-colors">18-Month Timeline</a></li>
        <li><a href="/blog/14-month-wedding-planning-timeline" class="hover:text-white transition-colors">14-Month Timeline</a></li>
        <li><a href="/blog/hairstyles-for-wedding" class="hover:text-white transition-colors">Bridal Hairstyles</a></li>
        <li><a href="/blog/how-to-choose-wedding-venue" class="hover:text-white transition-colors">Venue Selection</a></li>
        <li><a href="/sitemap" class="hover:text-white transition-colors">Sitemap &amp; Directory</a></li>
        <li><a href="/privacy-policy" class="hover:text-white transition-colors">Privacy Policy</a></li>
      </ul>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-12 pt-8 border-t border-slate-800 text-center text-xs text-slate-500">
    © 2026 WeddingPlanningChecklists.org. All rights reserved.
  </div>
</footer>
